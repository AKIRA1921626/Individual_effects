-- ヘルパーモジュールの読み込みを試行
local condition, AKIRA_helper = pcall(require, "AKIRA_aviutl2_helper_ide_202261128")
local AKIRA_h = nil
if condition then
    AKIRA_h = AKIRA_helper
else
    debug_print("AKIRA_aviutl2_helper_ide_202261128.luaが同じフォルダに存在しません。")
end

-- 個別オブジェクトが有効かを確認
local is_multi = obj.getoption("multi_object")
if not is_multi then
    debug_print("個別オブジェクトが有効ではないため、「個別エフェクト」処理をスキップします。")
    return
end

-- ================================================================
-- グローバル変数の初期化 (index == 0 のときリセット)
-- 各文字の位置・変形情報をここに蓄積していく
-- ================================================================
if obj.index == 0 then
    _G.gi_ox    = {}  -- 各文字の obj.ox
    _G.gi_oy    = {}  -- 各文字の obj.oy
    _G.gi_oz    = {}  -- 各文字の obj.oz
    _G.gi_scale = {}  -- 各文字の obj.sx (拡大率)
    _G.gi_alpha = {}  -- 各文字の alpha
    _G.gi_rx    = {}  -- 各文字の obj.rx
    _G.gi_ry    = {}  -- 各文字の obj.ry
    _G.gi_rz    = {}  -- 各文字の obj.rz
    _G.gi_has_packed_A = false
    _G.gi_has_packed_B = false
    _G.gi_has_packed_C = false
end

-- ----------------------------------------------------------------
-- まず、現在の文字の位置・変形情報をグローバル変数に保存する
-- ----------------------------------------------------------------
local idx   = obj.index
local last = obj.num-1
local scale = obj.sx
local alpha = obj.getvalue("alpha")

_G.gi_ox[idx]    = obj.ox
_G.gi_oy[idx]    = obj.oy
_G.gi_oz[idx]    = obj.oz
_G.gi_scale[idx] = scale
_G.gi_alpha[idx] = alpha
_G.gi_rx[idx]    = obj.rx
_G.gi_ry[idx]    = obj.ry
_G.gi_rz[idx]    = obj.rz

-- グループ範囲の正規化 (逆順指定でも正しく動くよう min/max で補正)
-- 終了文字が文字数を超えた場合は最後の文字に自動クランプ
local total_char = obj.num  -- テキストの総文字数 (1-based)
local sA = math.min(startA, endA)                         -- Aグループ開始 (1-based)
local eA = math.min(math.max(startA, endA), total_char)   -- Aグループ終了 (1-based, 上限クランプ)
local sB = math.min(startB, endB)                         -- Bグループ開始 (1-based)
local eB = math.min(math.max(startB, endB), total_char)   -- Bグループ終了 (1-based, 上限クランプ)
local sC = math.min(startC, endC)                         -- Cグループ開始 (1-based)
local eC = math.min(math.max(startC, endC), total_char)   -- Cグループ終了 (1-based, 上限クランプ)

-- 現在の文字番号 (1-based)
local current_char = idx + 1

-- グループ判定
local inA = (current_char >= sA and current_char <= eA)
local inB = (current_char >= sB and current_char <= eB)
local inC = (current_char >= sC and current_char <= eC)

-- 範囲外文字の最後のインデックスを検索 (pack == 1 用)
local pack = pack or 0
local last_other_idx = -1
if pack == 1 then
    for i = 0, obj.num - 1 do
        local c = i + 1
        local is_in_grp = (c >= sA and c <= eA) or (c >= sB and c <= eB) or (c >= sC and c <= eC)
        if not is_in_grp then
            last_other_idx = i
        end
    end
end

-- ここに各グループのオブジェクトのサイズを求める変数を作る予定
-- ここに変数を作成する

-- ================================================================
-- まとめた文字群の中心点を計算する関数
-- ================================================================
local function get_group_center(start_num, end_num)
    local s = math.min(start_num, end_num)
    local e = math.max(start_num, end_num)
    local min_x, max_x = math.huge, -math.huge
    local min_y, max_y = math.huge, -math.huge
    local count = 0

    for i = s - 1, e - 1 do
        local ox = _G.gi_ox and _G.gi_ox[i]
        local oy = _G.gi_oy and _G.gi_oy[i]
        local w  = (_G.gi_w and _G.gi_w[i]) or 0
        local h  = (_G.gi_h and _G.gi_h[i]) or 0
        if ox and oy then
            count = count + 1
            local left   = ox - w / 2
            local right  = ox + w / 2
            local top    = oy - h / 2
            local bottom = oy + h / 2
            if left < min_x then min_x = left end
            if right > max_x then max_x = right end
            if top < min_y then min_y = top end
            if bottom > max_y then max_y = bottom end
        end
    end

    if count == 0 then
        return 0, 0
    end

    return (min_x + max_x) / 2, (min_y + max_y) / 2
end

-- ================================================================
-- 合成バッファのサイズを取得
-- テキスト全体が収まるサイズ (各文字を ox,oy で配置できるよう全体サイズが必要)
-- ================================================================
local full_w = obj.screen_w
local full_h = obj.screen_h
if AKIRA_h then
    local tw, th = AKIRA_h.get_text_size()
    local lc     = AKIRA_h.line_break_confirmation()
    full_w = math.min(obj.screen_w, tw)
    full_h = math.min(obj.screen_h, th * lc)
end

-- ================================================================
-- グループAの処理
-- ================================================================
if inA then

    if current_char < eA then
        -- --------------------------------------------------------
        -- 【Aグループ: 非終了文字の処理】
        -- 仮想バッファ(フルサイズ)を新規作成し、
        -- 保存した ox,oy の位置にこの文字を描画して cache に保存する
        -- --------------------------------------------------------

        -- フルサイズの仮想バッファを新規作成・クリア
        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        -- グローバル変数に保存した ox,oy の位置に描画
        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        -- 仮想バッファをキャッシュに保存 ("cache:gi_A_インデックス" の形式)
        obj.copybuffer("cache:gi_A_" .. idx, "tempbuffer")

        -- この文字は cache に保存したので framebuffer には描画しない (alpha=0 で不可視)
        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")
        obj.clearbuffer("object")

        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","startA")

    elseif current_char == eA then
        -- --------------------------------------------------------
        -- 【Aグループ: 終了文字の処理】
        -- フルサイズの仮想バッファを新規作成し、
        -- 1) 終了文字を ox,oy に描画
        -- 2) これまでの全 cache を各文字の保存済み ox,oy で描画
        -- 3) 仮想バッファを load してエフェクトを適用し framebuffer に描画
        -- --------------------------------------------------------

        -- フルサイズの仮想バッファを新規作成・クリア
        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        -- (1) 終了文字(現在の文字)の ox,oy をグローバルに保存し、その位置に描画
        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        -- (2) 開始文字 ～ 終了文字の1つ前 までのキャッシュを順番に描画
        --     各キャッシュはフルサイズ画像として ox,oy が既に適用されているため
        --     (0,0,0, 1,1, 0,0,0) でそのまま合成する
        for i = sA - 1, eA - 2 do  -- 0-based index: sA-1 から eA-2 まで
            obj.copybuffer("object","cache:gi_A_" .. i)
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end

        -- (3) 合成した仮想バッファを framebuffer に描画 (エフェクト適用)
        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")

        -- まとまった文字群の中心に中心点(cx, cy)と描画座標(ox, oy)を移動
        local cxA, cyA = get_group_center(startA, endA)
        obj.cx = cxA
        obj.cy = cyA
        obj.ox = cxA
        obj.oy = cyA

        -- ↓ Aグループへのエフェクト適用 ↓
        if effectA == 1 then
            obj.effect("グラデーション",
            "強さ",grd_powA,
            "中心X",grd_cxA,
            "中心Y",grd_cyA,
            "角度",grd_rotateA,
            "幅",grd_widthA,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colA,
            "終了色",grd_end_colA
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA0,
            "高さ",edge_heightA0,
            "角度",edge_rotateA0
            )
        elseif effectA == 2 then
            obj.effect("グラデーション",
            "強さ",grd_powA,
            "中心X",grd_cxA,
            "中心Y",grd_cyA,
            "角度",grd_rotateA,
            "幅",grd_widthA,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colA,
            "終了色",grd_end_colA
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA0,
            "高さ",edge_heightA0,
            "角度",edge_rotateA0
            )
            obj.effect("縁取り",
            "サイズ",frame_sA0,
            "ぼかし",frame_bA0,
            "縁色",frame_colA0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA1,
            "高さ",edge_heightA1,
            "角度",edge_rotateA1
            )
        elseif effectA == 3 then
            obj.effect("グラデーション",
            "強さ",grd_powA,
            "中心X",grd_cxA,
            "中心Y",grd_cyA,
            "角度",grd_rotateA,
            "幅",grd_widthA,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colA,
            "終了色",grd_end_colA
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA0,
            "高さ",edge_heightA0,
            "角度",edge_rotateA0
            )
            obj.effect("縁取り",
            "サイズ",frame_sA0,
            "ぼかし",frame_bA0,
            "縁色",frame_colA0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA1,
            "高さ",edge_heightA1,
            "角度",edge_rotateA1
            )
            obj.effect("縁取り",
            "サイズ",frame_sA1,
            "ぼかし",frame_bA1,
            "縁色",frame_colA1
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA2,
            "高さ",edge_heightA2,
            "角度",edge_rotateA2
            )
        elseif effectA == 4 then
            obj.effect("グラデーション",
            "強さ",grd_powA,
            "中心X",grd_cxA,
            "中心Y",grd_cyA,
            "角度",grd_rotateA,
            "幅",grd_widthA,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colA,
            "終了色",grd_end_colA
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA0,
            "高さ",edge_heightA0,
            "角度",edge_rotateA0
            )
            obj.effect("縁取り",
            "サイズ",frame_sA0,
            "ぼかし",frame_bA0,
            "縁色",frame_colA0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA1,
            "高さ",edge_heightA1,
            "角度",edge_rotateA1
            )
            obj.effect("縁取り",
            "サイズ",frame_sA1,
            "ぼかし",frame_bA1,
            "縁色",frame_colA1
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA2,
            "高さ",edge_heightA2,
            "角度",edge_rotateA2
            )
            obj.effect("縁取り",
            "サイズ",frame_sA2,
            "ぼかし",frame_bA2,
            "縁色",frame_colA2
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA3,
            "高さ",edge_heightA3,
            "角度",edge_rotateA3
            )
        elseif effectA == 5 then
            obj.effect("グラデーション",
            "強さ",grd_powA,
            "中心X",grd_cxA,
            "中心Y",grd_cyA,
            "角度",grd_rotateA,
            "幅",grd_widthA,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colA,
            "終了色",grd_end_colA
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA0,
            "高さ",edge_heightA0,
            "角度",edge_rotateA0
            )
            obj.effect("縁取り",
            "サイズ",frame_sA0,
            "ぼかし",frame_bA0,
            "縁色",frame_colA0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA1,
            "高さ",edge_heightA1,
            "角度",edge_rotateA1
            )
            obj.effect("縁取り",
            "サイズ",frame_sA1,
            "ぼかし",frame_bA1,
            "縁色",frame_colA1
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA2,
            "高さ",edge_heightA2,
            "角度",edge_rotateA2
            )
            obj.effect("縁取り",
            "サイズ",frame_sA2,
            "ぼかし",frame_bA2,
            "縁色",frame_colA2
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA3,
            "高さ",edge_heightA3,
            "角度",edge_rotateA3
            )
            obj.effect("ドロップシャドウ",
            "X",drop_shadow_xA,
            "Y",drop_shadow_yA,
            "濃さ",drop_shadow_deepA,
            "拡散",drop_shadow_diffusionA,
            "影色",drop_shadow_colorA,
            "影を別オブジェクトで描画",0
            )
        elseif effectA == 6 then
            obj.effect("グラデーション",
            "強さ",grd_powA,
            "中心X",grd_cxA,
            "中心Y",grd_cyA,
            "角度",grd_rotateA,
            "幅",grd_widthA,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colA,
            "終了色",grd_end_colA
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA0,
            "高さ",edge_heightA0,
            "角度",edge_rotateA0
            )
            obj.effect("縁取り",
            "サイズ",frame_sA0,
            "ぼかし",frame_bA0,
            "縁色",frame_colA0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA1,
            "高さ",edge_heightA1,
            "角度",edge_rotateA1
            )
            obj.effect("縁取り",
            "サイズ",frame_sA1,
            "ぼかし",frame_bA1,
            "縁色",frame_colA1
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA2,
            "高さ",edge_heightA2,
            "角度",edge_rotateA2
            )
            obj.effect("縁取り",
            "サイズ",frame_sA2,
            "ぼかし",frame_bA2,
            "縁色",frame_colA2
            )
            obj.effect("凸エッジ",
            "幅",edge_widthA3,
            "高さ",edge_heightA3,
            "角度",edge_rotateA3
            )
            obj.effect("ドロップシャドウ",
            "X",drop_shadow_xA,
            "Y",drop_shadow_yA,
            "濃さ",drop_shadow_deepA,
            "拡散",drop_shadow_diffusionA,
            "影色",drop_shadow_colorA,
            "影を別オブジェクトで描画",0
            )
            obj.effect("枠線",
            "X",border_xA,
            "Y",border_yA,
            "サイズ",border_sA,
            "丸み",border_rA,
            "枠色",border_colA
            )
        end
        -- ↑ エフェクト追加ここまで ↑

        if pack == 2 then
            -- すべての文字をまとめるモード: エフェクト適用後バッファに描画してキャッシュに保存し、画面上は不可視
            obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
            obj.clearbuffer("tempbuffer")
            obj.ox = 0; obj.oy = 0; obj.oz = 0; obj.rx = 0; obj.ry = 0; obj.rz = 0; obj.cx = 0; obj.cy = 0
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)  -- 合成済み画像を位置オフセットなしで描画
            obj.copybuffer("cache:packed_group_A", "tempbuffer")
            _G.gi_has_packed_A = true

            obj.setoption("drawtarget", "framebuffer")
            obj.clearbuffer("object")
        else
            obj.clearbuffer("tempbuffer")
        end
        
        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","endA")

    end

-- ================================================================
-- グループBの処理
-- ================================================================
elseif inB then

    if current_char < eB then
        -- --------------------------------------------------------
        -- 【Bグループ: 非終了文字の処理】
        -- グループAと同じロジック
        -- --------------------------------------------------------

        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        obj.copybuffer("cache:gi_B_" .. idx, "tempbuffer")

        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")
        obj.clearbuffer("object")
        
        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","startB")

    elseif current_char == eB then
        -- --------------------------------------------------------
        -- 【Bグループ: 終了文字の処理】
        -- グループAと同じロジック
        -- --------------------------------------------------------

        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        for i = sB - 1, eB - 2 do  -- 0-based index: sB-1 から eB-2 まで
            obj.copybuffer("object","cache:gi_B_" .. i)
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end

        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")

        -- まとまった文字群の中心に中心点(cx, cy)と描画座標(ox, oy)を移動
        local cxB, cyB = get_group_center(startB, endB)
        obj.cx = cxB
        obj.cy = cyB
        obj.ox = cxB
        obj.oy = cyB

        -- ↓ Bグループへのエフェクト適用 ↓
        if effectB == 1 then
            obj.effect("グラデーション",
            "強さ",grd_powB,
            "中心X",grd_cxB,
            "中心Y",grd_cyB,
            "角度",grd_rotateB,
            "幅",grd_widthB,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colB,
            "終了色",grd_end_colB
            )
            obj.effect("凸エッジ",
            "幅",edge_widthB0,
            "高さ",edge_heightB0,
            "角度",edge_rotateB0
            )
        elseif effectB == 2 then
            obj.effect("グラデーション",
            "強さ",grd_powB,
            "中心X",grd_cxB,
            "中心Y",grd_cyB,
            "角度",grd_rotateB,
            "幅",grd_widthB,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colB,
            "終了色",grd_end_colB
            )
            obj.effect("凸エッジ",
            "幅",edge_widthB0,
