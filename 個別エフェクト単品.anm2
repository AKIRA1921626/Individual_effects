        -- debug_print(current_char.."文字目","endB")

    end

-- ================================================================
-- グループCの処理
-- ================================================================
elseif inC then

    if current_char < eC then
        -- --------------------------------------------------------
        -- 【Cグループ: 非終了文字の処理】
        -- グループAと同じロジック
        -- --------------------------------------------------------

        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        obj.copybuffer("cache:gi_C_" .. idx, "tempbuffer")

        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")
        obj.clearbuffer("object")
        
        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","startC")

    elseif current_char == eC then
        -- --------------------------------------------------------
        -- 【Cグループ: 終了文字の処理】
        -- グループAと同じロジック
        -- --------------------------------------------------------

        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        for i = sC - 1, eC - 2 do  -- 0-based index: sC-1 から eC-2 まで
            obj.copybuffer("object","cache:gi_C_" .. i)
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
        
        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")


        -- まとまった文字群の中心に中心点(cx, cy)と描画座標(ox, oy)を移動
        local cxC, cyC = get_group_center(startC, endC)
        obj.cx = cxC
        obj.cy = cyC
        obj.ox = cxC
        obj.oy = cyC

        -- ↓ Cグループへのエフェクト適用 ↓
        if effectC == 1 then
            obj.effect("グラデーション",
            "強さ",grd_powC,
            "中心X",grd_cxC,
            "中心Y",grd_cyC,
            "角度",grd_rotateC,
            "幅",grd_widthC,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colC,
            "終了色",grd_end_colC
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC0,
            "高さ",edge_heightC0,
            "角度",edge_rotateC0
            )
        elseif effectC == 2 then
            obj.effect("グラデーション",
            "強さ",grd_powC,
            "中心X",grd_cxC,
            "中心Y",grd_cyC,
            "角度",grd_rotateC,
            "幅",grd_widthC,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colC,
            "終了色",grd_end_colC
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC0,
            "高さ",edge_heightC0,
            "角度",edge_rotateC0
            )
            obj.effect("縁取り",
            "サイズ",frame_sC0,
            "ぼかし",frame_bC0,
            "縁色",frame_colC0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC1,
            "高さ",edge_heightC1,
            "角度",edge_rotateC1
            )
        elseif effectC == 3 then
            obj.effect("グラデーション",
            "強さ",grd_powC,
            "中心X",grd_cxC,
            "中心Y",grd_cyC,
            "角度",grd_rotateC,
            "幅",grd_widthC,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colC,
            "終了色",grd_end_colC
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC0,
            "高さ",edge_heightC0,
            "角度",edge_rotateC0
            )
            obj.effect("縁取り",
            "サイズ",frame_sC0,
            "ぼかし",frame_bC0,
            "縁色",frame_colC0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC1,
            "高さ",edge_heightC1,
            "角度",edge_rotateC1
            )
            obj.effect("縁取り",
            "サイズ",frame_sC1,
            "ぼかし",frame_bC1,
            "縁色",frame_colC1
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC2,
            "高さ",edge_heightC2,
            "角度",edge_rotateC2
            )
        elseif effectC == 4 then
            obj.effect("グラデーション",
            "強さ",grd_powC,
            "中心X",grd_cxC,
            "中心Y",grd_cyC,
            "角度",grd_rotateC,
            "幅",grd_widthC,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colC,
            "終了色",grd_end_colC
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC0,
            "高さ",edge_heightC0,
            "角度",edge_rotateC0
            )
            obj.effect("縁取り",
            "サイズ",frame_sC0,
            "ぼかし",frame_bC0,
            "縁色",frame_colC0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC1,
            "高さ",edge_heightC1,
            "角度",edge_rotateC1
            )
            obj.effect("縁取り",
            "サイズ",frame_sC1,
            "ぼかし",frame_bC1,
            "縁色",frame_colC1
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC2,
            "高さ",edge_heightC2,
            "角度",edge_rotateC2
            )
            obj.effect("縁取り",
            "サイズ",frame_sC2,
            "ぼかし",frame_bC2,
            "縁色",frame_colC2
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC3,
            "高さ",edge_heightC3,
            "角度",edge_rotateC3
            )
        elseif effectC == 5 then
            obj.effect("グラデーション",
            "強さ",grd_powC,
            "中心X",grd_cxC,
            "中心Y",grd_cyC,
            "角度",grd_rotateC,
            "幅",grd_widthC,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colC,
            "終了色",grd_end_colC
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC0,
            "高さ",edge_heightC0,
            "角度",edge_rotateC0
            )
            obj.effect("縁取り",
            "サイズ",frame_sC0,
            "ぼかし",frame_bC0,
            "縁色",frame_colC0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC1,
            "高さ",edge_heightC1,
            "角度",edge_rotateC1
            )
            obj.effect("縁取り",
            "サイズ",frame_sC1,
            "ぼかし",frame_bC1,
            "縁色",frame_colC1
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC2,
            "高さ",edge_heightC2,
            "角度",edge_rotateC2
            )
            obj.effect("縁取り",
            "サイズ",frame_sC2,
            "ぼかし",frame_bC2,
            "縁色",frame_colC2
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC3,
            "高さ",edge_heightC3,
            "角度",edge_rotateC3
            )
            obj.effect("ドロップシャドウ",
            "X",drop_shadow_xC,
            "Y",drop_shadow_yC,
            "濃さ",drop_shadow_deepC,
            "拡散",drop_shadow_diffusionC,
            "影色",drop_shadow_colorC,
            "影を別オブジェクトで描画",0
            )
        elseif effectC == 6 then
            obj.effect("グラデーション",
            "強さ",grd_powC,
            "中心X",grd_cxC,
            "中心Y",grd_cyC,
            "角度",grd_rotateC,
            "幅",grd_widthC,
            "合成モード","通常",
            "形状","線形",
            "開始色",grd_start_colC,
            "終了色",grd_end_colC
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC0,
            "高さ",edge_heightC0,
            "角度",edge_rotateC0
            )
            obj.effect("縁取り",
            "サイズ",frame_sC0,
            "ぼかし",frame_bC0,
            "縁色",frame_colC0
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC1,
            "高さ",edge_heightC1,
            "角度",edge_rotateC1
            )
            obj.effect("縁取り",
            "サイズ",frame_sC1,
            "ぼかし",frame_bC1,
            "縁色",frame_colC1
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC2,
            "高さ",edge_heightC2,
            "角度",edge_rotateC2
            )
            obj.effect("縁取り",
            "サイズ",frame_sC2,
            "ぼかし",frame_bC2,
            "縁色",frame_colC2
            )
            obj.effect("凸エッジ",
            "幅",edge_widthC3,
            "高さ",edge_heightC3,
            "角度",edge_rotateC3
            )
            obj.effect("ドロップシャドウ",
            "X",drop_shadow_xC,
            "Y",drop_shadow_yC,
            "濃さ",drop_shadow_deepC,
            "拡散",drop_shadow_diffusionC,
            "影色",drop_shadow_colorC,
            "影を別オブジェクトで描画",0
            )
            obj.effect("枠線",
            "X",border_xC,
            "Y",border_yC,
            "サイズ",border_sC,
            "丸み",border_rC,
            "枠色",border_colC
            )
        end
                -- ↑ エフェクト追加ここまで ↑

        if pack == 2 then
            -- すべての文字をまとめるモード: エフェクト適用後バッファに描画してキャッシュに保存し、画面上は不可視
            obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
            obj.clearbuffer("tempbuffer")
            obj.ox = 0; obj.oy = 0; obj.oz = 0; obj.rx = 0; obj.ry = 0; obj.rz = 0; obj.cx = 0; obj.cy = 0
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)  -- 合成済み画像を位置オフセットなしで描画
            obj.copybuffer("cache:packed_group_C", "tempbuffer")
            _G.gi_has_packed_C = true

            obj.setoption("drawtarget", "framebuffer")
            obj.clearbuffer("object")
        else
            obj.clearbuffer("tempbuffer")
        end
        
        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","endC")

    end


-- ================================================================
-- グループ外の文字: pack の設定に応じてまとめるか個別描画するか切り替え
-- ================================================================
elseif idx <= last then
    if pack == 2 then
        -- pack == 2 (すべての文字をまとめる): 範囲外文字はキャッシュに保存し、画面上は不可視
        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        obj.copybuffer("cache:gi_other_" .. idx, "tempbuffer")

        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")
        obj.clearbuffer("object")

    elseif pack == 1 then
        -- pack == 1 (範囲外の文字をまとめる):
        if idx < last_other_idx then
            -- 最後の範囲外文字ではない場合: キャッシュに保存し画面上は不可視
            obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
            obj.clearbuffer("tempbuffer")

            obj.draw(
                _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
                _G.gi_scale[idx], _G.gi_alpha[idx],
                _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
            )

            obj.copybuffer("cache:gi_other_" .. idx, "tempbuffer")

            obj.setoption("drawtarget", "framebuffer")
            obj.load("tempbuffer")
            obj.clearbuffer("object")
        else
            -- 最後の範囲外文字の場合: 範囲外文字群を合成して出力
            obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
            obj.clearbuffer("tempbuffer")

            for i = 0, idx - 1 do
                local c = i + 1
                local is_in_grp = (c >= sA and c <= eA) or (c >= sB and c <= eB) or (c >= sC and c <= eC)
                if not is_in_grp then
                    obj.copybuffer("object", "cache:gi_other_" .. i)
                    obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
                end
            end

            obj.draw(
                _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
                _G.gi_scale[idx], _G.gi_alpha[idx],
                _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
            )

            obj.setoption("drawtarget", "framebuffer")
            obj.load("tempbuffer")
            obj.clearbuffer("tempbuffer")
        end
    else
        -- pack == 0 (まとめない: 元のまま個別描画)
        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )
        obj.load("tempbuffer")
        obj.clearbuffer("tempbuffer")
    end
        
    -- デバッグ用の記述(配布時にはコメントアウトする)
    -- debug_print(current_char.."文字目","elseif")
else
        
    -- デバッグ用の記述(配布時にはコメントアウトする)
    -- debug_print(current_char.."文字目","else")
    return
end

-- ================================================================
-- 【pack == 2: すべての文字をまとめる】
-- 最後の文字(idx == last)のタイミングで、全文字（全グループ＋範囲外文字）を1枚のオブジェクトに合成
-- ================================================================
if pack == 2 and idx == last then
    obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
    obj.clearbuffer("tempbuffer")

    -- 1. 範囲外文字のキャッシュを順番に描画
    for i = 0, obj.num - 1 do
        local c = i + 1
        local is_in_grp = (c >= sA and c <= eA) or (c >= sB and c <= eB) or (c >= sC and c <= eC)
        if not is_in_grp then
            if obj.copybuffer("object", "cache:gi_other_" .. i) then
                obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
            end
        end
    end

    -- 2. エフェクト適用済みAグループを描画
    if _G.gi_has_packed_A then
        if obj.copybuffer("object", "cache:packed_group_A") then
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
    end

    -- 3. エフェクト適用済みBグループを描画
    if _G.gi_has_packed_B then
        if obj.copybuffer("object", "cache:packed_group_B") then
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
    end

    -- 4. エフェクト適用済みCグループを描画
    if _G.gi_has_packed_C then
        if obj.copybuffer("object", "cache:packed_group_C") then
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
    end

    -- 5. 合成された単一オブジェクトをフレームバッファに出力
    obj.setoption("drawtarget", "framebuffer")
    obj.load("tempbuffer")
    obj.clearbuffer("tempbuffer")
end
