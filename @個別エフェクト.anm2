--check@p_7_4_A:Aグループ(ミラー)::中心の位置を変更,0

--group

--group:Bグループ
--track@startB:Bグループ::開始B,1,100,1,1
--track@endB:Bグループ::終了B,1,100,1,1
--select@effectB:Bグループ::エフェクト=0,なし=0,画像ループ=1,オブジェクト分割=2,座標の拡大縮小(個別オブジェクト)=3,座標の回転(個別オブジェクト)=4,円形配置=5,ランダム配置=6,ミラー=7

--track@p_1_0_B:Bグループ(画像ループ)::横回数,1,100,1,1
--track@p_1_1_B:Bグループ(画像ループ)::縦回数,1,100,1,1
--track@p_1_2_B:Bグループ(画像ループ)::オフセットX,-10000.000,10000.000,0.000,0.001
