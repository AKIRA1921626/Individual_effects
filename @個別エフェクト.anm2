-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- selectの数字を文字列に変換するテーブル
local TBL_7_3 = {"上側", "下側", "左側", "右側"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("画像ループ",
            "横回数", p_1_0_A,
            "縦回数", p_1_1_A,
            "オフセットX", p_1_2_A,
            "オフセットY", p_1_3_A,
            "個別オブジェクト", p_1_4_A
        )
    elseif effectA == 2 then
        obj.effect("オブジェクト分割",
            "横分割数", p_2_0_A,
            "縦分割数", p_2_1_A
        )
    elseif effectA == 3 then
        obj.effect("座標の拡大縮小(個別オブジェクト)",
            "拡大率", p_3_0_A,
            "中心X", p_3_1_A,
            "中心Y", p_3_2_A
        )
    elseif effectA == 4 then
        obj.effect("座標の回転(個別オブジェクト)",
            "角度", p_4_0_A,
            "中心X", p_4_1_A,
            "中心Y", p_4_2_A
        )
    elseif effectA == 5 then
        obj.effect("円形配置",
            "円周", p_5_0_A,
            "半径", p_5_1_A,
            "回転", p_5_2_A,
            "ずらし", p_5_3_A,
            "数", p_5_4_A,
            "水平配置(カメラ制御)", p_5_5_A,
            "向き反転", p_5_6_A,
            "回転無し", p_5_7_A
        )
    elseif effectA == 6 then
        obj.effect("ランダム配置",
            "数", p_6_0_A,
            "範囲", p_6_1_A,
            "回転", p_6_2_A,
            "拡散", p_6_3_A,
            "3D配置(カメラ制御)", p_6_4_A,
            "ランダム角度", p_6_5_A,
            "カメラの方向を向く", p_6_6_A
        )
    elseif effectA == 7 then
        obj.effect("ミラー",
            "透明度", p_7_0_A,
            "減衰", p_7_1_A,
            "境目調整", p_7_2_A,
            "ミラーの方向", TBL_7_3[p_7_3_A],
            "中心の位置を変更", p_7_4_A
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
