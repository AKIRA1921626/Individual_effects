-- Cグループ固有のエフェクト処理
local function apply_effect_C()
        if effectC == 1 then
            obj.effect("縁取り",
            "サイズ",frame_sC,
            "ぼかし",frame_bC,
            "縁色",frame_colC
            )
        elseif effectC == 2 then
