        }
        if p_3_4_C ~= nil then table.insert(args, "影色"); table.insert(args, p_3_4_C) end
        obj.effect("ドロップシャドウ", unpack(args))
    elseif effectC == 4 then
        obj.effect("凸エッジ",
            "幅", p_4_0_C,
