-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then -- 形状への変換テーブル未作成のため、一旦定数。
        obj.effect("グロー",
        "強さ",glow2_strengthA,
        "拡散",glow2_diffusionA,
        "角度",glow2_angleA,
        "しきい値",glow2_thresholdA,
        "比率",glow2_ratioA,
        "ぼかし",glow2_blurA,
        "形状","クロス(4本)",
        "光成分のみ",glow2_disableA,
        "サイズ固定",0
        )
    elseif effectA == 2 then -- 光色の項目は一旦保留
        obj.effect("発光",
        "強さ",glow_strengthA,
        "拡散",glow_diffusionA,
        "しきい値",glow_thresholdA,
        "拡散速度",glow_speedA,
        "サイズ固定",0
        )
    elseif effectA == 3 then -- 色ずれの種類への変換テーブル未作成のため、一旦定数。
        obj.effect("色ずれ",
        "ずれ幅",shift_widthA,
        "角度",shift_angleA,
        "強さ",shift_strengthA,
        "色ずれの種類","赤緑A"
        )
    elseif effectA == 4 then
        obj.effect("モザイク",
        "サイズ",mosaic_sizeA,
        "タイル風",mosaic_tileA
        )
    elseif effectA == 5 then -- ミラーの方向への変換テーブル未作成のため、一旦定数。
        obj.effect("ミラー",
        "透明度",mirror_alphaA,
        "減衰",mirror_attenuationA,
        "境目調整",mirror_boundaryA,
        "ミラーの方向","下側",
        "中心の位置を変更",0
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then -- 形状への変換テーブル未作成のため、一旦定数。
        obj.effect("グロー",
        "強さ",glow2_strengthB,
        "拡散",glow2_diffusionB,
        "角度",glow2_angleB,
        "しきい値",glow2_thresholdB,
        "比率",glow2_ratioB,
        "ぼかし",glow2_blurB,
        "形状","クロス(4本)",
        "光成分のみ",glow2_disableB,
        "サイズ固定",0
        )
    elseif effectB == 2 then -- 光色の項目は一旦保留
        obj.effect("発光",
        "強さ",glow_strengthB,
        "拡散",glow_diffusionB,
        "しきい値",glow_thresholdB,
        "拡散速度",glow_speedB,
        "サイズ固定",0
        )
    elseif effectB == 3 then -- 色ずれの種類への変換テーブル未作成のため、一旦定数。
        obj.effect("色ずれ",
        "ずれ幅",shift_widthB,
        "角度",shift_angleB,
        "強さ",shift_strengthB,
        "色ずれの種類","赤緑A"
        )
    elseif effectB == 4 then
        obj.effect("モザイク",
        "サイズ",mosaic_sizeB,
        "タイル風",mosaic_tileB
        )
    elseif effectB == 5 then -- ミラーの方向への変換テーブル未作成のため、一旦定数。
        obj.effect("ミラー",
        "透明度",mirror_alphaB,
        "減衰",mirror_attenuationB,
        "境目調整",mirror_boundaryB,
        "ミラーの方向","下側",
        "中心の位置を変更",0
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then -- 形状への変換テーブル未作成のため、一旦定数。
        obj.effect("グロー",
        "強さ",glow2_strengthC,
        "拡散",glow2_diffusionC,
        "角度",glow2_angleC,
        "しきい値",glow2_thresholdC,
        "比率",glow2_ratioC,
        "ぼかし",glow2_blurC,
        "形状","クロス(4本)",
        "光成分のみ",glow2_disableC,
        "サイズ固定",0
        )
    elseif effectC == 2 then -- 光色の項目は一旦保留
        obj.effect("発光",
        "強さ",glow_strengthC,
        "拡散",glow_diffusionC,
        "しきい値",glow_thresholdC,
        "拡散速度",glow_speedC,
        "サイズ固定",0
        )
    elseif effectC == 3 then -- 色ずれの種類への変換テーブル未作成のため、一旦定数。
        obj.effect("色ずれ",
        "ずれ幅",shift_widthC,
        "角度",shift_angleC,
        "強さ",shift_strengthC,
        "色ずれの種類","赤緑A"
        )
    elseif effectC == 4 then
        obj.effect("モザイク",
        "サイズ",mosaic_sizeC,
        "タイル風",mosaic_tileC
        )
    elseif effectC == 5 then -- ミラーの方向への変換テーブル未作成のため、一旦定数。
        obj.effect("ミラー",
        "透明度",mirror_alphaC,
        "減衰",mirror_attenuationC,
        "境目調整",mirror_boundaryC,
        "ミラーの方向","下側",
        "中心の位置を変更",0
        )
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

