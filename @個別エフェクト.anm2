-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

@個別エフェクト(標準:アニメーション効果)
--label:個別エフェクト
--information:個別オブジェクトにした文字の中から、指定した範囲(A・B・Cグループ)をそれぞれ1つのオブジェクトとしてまとめ、各グループに個別のエフェクトを適用するスクリプト。グループ外の文字はそのまま表示される。使用できるエフェクトは標準スクリプトの「アニメーション効果」のみ。

--group:文字のまとめ方,true
--select@pack:方法=0,まとめない=0,範囲外の文字をまとめる=1,すべての文字をまとめる=2
--group

