-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("座標",
            "X", p_1_0_A,
            "Y", p_1_1_A,
            "Z", p_1_2_A
        )
    elseif effectA == 2 then
        obj.effect("拡大率",
            "拡大率", p_2_0_A,
            "X", p_2_1_A,
            "Y", p_2_2_A,
            "Z", p_2_3_A
        )
    elseif effectA == 3 then
        obj.effect("透明度",
            "透明度", p_3_0_A
        )
    elseif effectA == 4 then
        obj.effect("回転",
            "X", p_4_0_A,
            "Y", p_4_1_A,
            "Z", p_4_2_A
        )
    elseif effectA == 5 then
        obj.effect("領域拡張",
            "上", p_5_0_A,
            "下", p_5_1_A,
            "左", p_5_2_A,
            "右", p_5_3_A,
            "塗りつぶし", p_5_4_A
        )
    elseif effectA == 6 then
        obj.effect("ローテーション",
            "90度回転", p_6_0_A
        )
    elseif effectA == 7 then
        obj.effect("反転",
            "上下反転", p_7_0_A,
            "左右反転", p_7_1_A,
            "輝度反転", p_7_2_A,
            "色相反転", p_7_3_A,
            "透明度反転", p_7_4_A
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

