-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("振動",
            "X", p_1_0_A,
            "Y", p_1_1_A,
            "Z", p_1_2_A,
            "周期", p_1_3_A,
            "ランダムに強さを変える", p_1_4_A,
            "複雑に振動", p_1_5_A
        )
    elseif effectA == 2 then
        local args = {
        }
        if p_2_0_A ~= nil and p_2_0_A ~= "" then table.insert(args, "スクリプト"); table.insert(args, p_2_0_A) end
        obj.effect("スクリプト制御", unpack(args))
    elseif effectA == 3 then
        obj.effect("震える",
            "振幅", p_3_0_A,
            "角度", p_3_1_A,
            "間隔", p_3_2_A
        )
    elseif effectA == 4 then
        obj.effect("振り子",
            "速さ", p_4_0_A,
            "角度", p_4_1_A,
            "ずらし", p_4_2_A
        )
    elseif effectA == 5 then
        obj.effect("弾む",
            "速さ", p_5_0_A,
            "高さ", p_5_1_A,
            "角度", p_5_2_A,
            "ずらし", p_5_3_A
        )
    elseif effectA == 6 then
        obj.effect("反復移動",
            "速さ", p_6_0_A,
            "距離", p_6_1_A,
            "角度", p_6_2_A,
            "ずらし", p_6_3_A
        )
    elseif effectA == 7 then
        obj.effect("砕け散る",
            "開始時間", p_7_0_A,
            "再生速度", p_7_1_A,
            "中心X", p_7_2_A,
            "中心Y", p_7_3_A,
            "中心Z", p_7_4_A,
            "破片サイズ", p_7_5_A,
            "速度", p_7_6_A,
            "重力", p_7_7_A,
            "時間差", p_7_8_A,
            "距離影響", p_7_9_A,
            "ランダム回転", p_7_10_A,
            "ランダム方向", p_7_11_A
        )
    elseif effectA == 8 then
        obj.effect("点滅",
            "速さ", p_8_0_A,
            "点滅割合", p_8_1_A,
            "点灯速度", p_8_2_A,
            "消灯速度", p_8_3_A
        )
    elseif effectA == 9 then
        obj.effect("リール回転",
            "回転数", p_9_0_A,
            "ブラー", p_9_1_A,
            "横回転", p_9_2_A
        )
    elseif effectA == 10 then
        obj.effect("粒子化",
            "開始時間", p_10_0_A,
            "再生速度", p_10_1_A,
            "起点X", p_10_2_A,
            "起点Y", p_10_3_A,
            "速度", p_10_4_A,
            "角度", p_10_5_A,
            "粒子速度", p_10_6_A,
            "拡大速度", p_10_7_A,
            "ゆらぎ", p_10_8_A,
            "ゆがみ", p_10_9_A,
            "ぼかし", p_10_10_A
        )
    end
end
