-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- selectの数字を文字列に変換するテーブル
local TBL_4_8 = {"移動変形", "拡大変形", "回転変形"}
local TBL_4_9 = {"円", "四角形", "三角形", "五角形", "六角形", "星型", "ハート", "仮想バッファ", "(ファイルから選択)"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("波紋",
            "中心X", p_1_0_A,
            "中心Y", p_1_1_A,
            "幅", p_1_2_A,
            "高さ", p_1_3_A,
            "速度", p_1_4_A,
            "波紋数", p_1_5_A,
            "波紋間隔", p_1_6_A,
            "増幅減衰回数", p_1_7_A
        )
    elseif effectA == 2 then
        obj.effect("ラスター",
            "横幅", p_2_0_A,
            "高さ", p_2_1_A,
            "周期", p_2_2_A,
            "縦ラスター", p_2_3_A,
            "ランダム振幅", p_2_4_A
        )
    elseif effectA == 3 then
        obj.effect("極座標変換",
            "中心幅", p_3_0_A,
            "拡大率", p_3_1_A,
            "回転", p_3_2_A,
            "渦巻", p_3_3_A
        )
    elseif effectA == 4 then
        obj.effect("ディスプレイスメントマップ",
            "X", p_4_0_A,
            "Y", p_4_1_A,
            "回転", p_4_2_A,
            "サイズ", p_4_3_A,
            "縦横比", p_4_4_A,
            "ぼかし", p_4_5_A,
            "変形X", p_4_6_A,
            "変形Y", p_4_7_A,
            "変形方法", TBL_4_8[p_4_8_A],
            "マップの種類", TBL_4_9[p_4_9_A],
            "元のサイズに合わせる", p_4_10_A
        )
    elseif effectA == 5 then
        obj.effect("リサイズ",
            "拡大率", p_5_0_A,
            "X", p_5_1_A,
            "Y", p_5_2_A,
            "補間なし", p_5_3_A,
            "ピクセル数でサイズ指定", p_5_4_A
        )
    elseif effectA == 6 then
        obj.effect("立方体(カメラ制御)",
            "サイズ", p_6_0_A
        )
    elseif effectA == 7 then
        obj.effect("球体(カメラ制御)",
            "サイズ", p_7_0_A
        )
    elseif effectA == 8 then
        local args = {
            "時間経過", p_8_0_A,
            "分割数", p_8_1_A,
        }
        if p_8_2_A ~= nil and p_8_2_A ~= "" then table.insert(args, "座標"); table.insert(args, p_8_2_A) end
        obj.effect("簡易変形", unpack(args))
    elseif effectA == 9 then
        local args = {
            "時間経過", p_9_0_A,
            "分割数", p_9_1_A,
        }
        if p_9_2_A ~= nil and p_9_2_A ~= "" then table.insert(args, "座標"); table.insert(args, p_9_2_A) end
        obj.effect("簡易変形(カメラ制御)", unpack(args))
    elseif effectA == 10 then
        obj.effect("万華鏡",
            "中心X", p_10_0_A,
            "中心Y", p_10_1_A,
            "長さ", p_10_2_A,
            "回転", p_10_3_A,
            "角数(偶数)", p_10_4_A,
            "繰り返し回数", p_10_5_A,
            "固定サイズ", p_10_6_A,
            "円形マスク", p_10_7_A,
            "回転同期", p_10_8_A,
            "領域外を透過", p_10_9_A,
            "表示位置確認", p_10_10_A
        )
    elseif effectA == 11 then
        local args = {
            "変形率", p_11_0_A,
            "横格子点", p_11_1_A,
            "縦格子点", p_11_2_A,
            "分割数", p_11_3_A,
        }
        if p_11_4_A ~= nil and p_11_4_A ~= "" then table.insert(args, "座標"); table.insert(args, p_11_4_A) end
        obj.effect("メッシュ変形", unpack(args))
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

