-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

@個別エフェクト(縁取り)
--label:個別エフェクト
--information:個別オブジェクトにした文字に対して、最大3段の多重縁取りを行うスクリプト。1段目(A/X)、2段目(B/Y)、3段目(C/Z)として重ねて適用され、各段ごとに指定文字と指定外文字で個別の縁色を設定できます。

--group:1段目::Aグループ
--select@effectA:1段目::縁取り=1,有効=1,なし=0
--track@startA:1段目::開始A,1,100,1,1
--track@endA:1段目::終了A,1,100,1,1
--track@sizeA:1段目::サイズA,0,1000,5,1
--track@blurA:1段目::ぼかしA,0,1000,0,1
--color@colorA:1段目::縁色(A),0xff0000
--color@colorX:1段目::指定外縁色(X),0xffffff
--group

--group:2段目::Bグループ
--select@effectB:2段目::縁取り=0,なし=0,有効=1
--track@startB:2段目::開始B,1,100,1,1
--track@endB:2段目::終了B,1,100,1,1
--track@sizeB:2段目::サイズB,0,1000,5,1
--track@blurB:2段目::ぼかしB,0,1000,0,1
--color@colorB:2段目::縁色(B),0x0000ff
--color@colorY:2段目::指定外縁色(Y),0x000000
--group

--group:3段目::Cグループ
--select@effectC:3段目::縁取り=0,なし=0,有効=1
--track@startC:3段目::開始C,1,100,1,1
--track@endC:3段目::終了C,1,100,1,1
--track@sizeC:3段目::サイズC,0,1000,5,1
--track@blurC:3段目::ぼかしC,0,1000,0,1
--color@colorC:3段目::縁色(C),0x00ff00
--color@colorZ:3段目::指定外縁色(Z),0x333333
--group

--hide@sizeA:effectA==0
--hide@blurA:effectA==0
--hide@colorA:effectA==0
--hide@colorX:effectA==0
--hide@sizeB:effectB==0
--hide@blurB:effectB==0
--hide@colorB:effectB==0
--hide@colorY:effectB==0
--hide@sizeC:effectC==0
--hide@blurC:effectC==0
--hide@colorC:effectC==0
--hide@colorZ:effectC==0

-- ヘルパーモジュールの読み込みを試行
local condition, AKIRA_helper = pcall(require, "AKIRA_aviutl2_helper")
local AKIRA_h = nil
if condition then
    AKIRA_h = AKIRA_helper
else
    debug_print("AKIRA_aviutl2_helper.luaが同じフォルダに存在しません。")
end

-- 個別オブジェクトが有効かを確認
local is_multi = obj.getoption("multi_object")
if not is_multi then
    debug_print("個別オブジェクトが有効ではないため、「個別エフェクト(縁取り)」処理をスキップします。")
    return
end

-- ================================================================
-- 合成バッファのサイズを取得 (他のスクリプトと同一にして位置ズレを防止)
-- ================================================================
local full_w = obj.screen_w
local full_h = obj.screen_h
if AKIRA_h then
    local tw, th = AKIRA_h.get_text_size()
    local lc     = AKIRA_h.line_break_confirmation()
    full_w = math.min(obj.screen_w, tw) + 100 -- 仮想バッファが足りていなかったので、適当に+100している
    full_h = math.min(obj.screen_h, th * lc) + 100 -- 仮想バッファが足りていなかったので、適当に+100している
end

-- ================================================================
-- index == 0 のとき：各キャッシュバッファの初期化
-- ================================================================
if obj.index == 0 then
    obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
    obj.clearbuffer("tempbuffer")

    -- 1段目用
    obj.copybuffer("cache:text_A", "tempbuffer")
    obj.copybuffer("cache:text_X", "tempbuffer")
    -- 2段目用
    obj.copybuffer("cache:text_B", "tempbuffer")
    obj.copybuffer("cache:text_Y", "tempbuffer")
    -- 3段目用
    obj.copybuffer("cache:text_C", "tempbuffer")
    obj.copybuffer("cache:text_Z", "tempbuffer")
    -- 最前面の文字本体用
    obj.copybuffer("cache:text_all", "tempbuffer")

    _G.gi_has_A = false
    _G.gi_has_X = false
    _G.gi_has_B = false
    _G.gi_has_Y = false
    _G.gi_has_C = false
    _G.gi_has_Z = false
end

-- ----------------------------------------------------------------
-- 各文字のパラメータ取得とグループ判定
-- ----------------------------------------------------------------
local idx = obj.index
local current_char = idx + 1
local scale = obj.sx
local alpha = obj.getvalue("alpha")

-- 各グループの範囲正規化
local sA, eA = math.min(startA, endA), math.max(startA, endA)
local sB, eB = math.min(startB, endB), math.max(startB, endB)
local sC, eC = math.min(startC, endC), math.max(startC, endC)
    -- グローバル変数に範囲情報を保存 (エフェクト追加用スクリプト向け)
    _G.gi_startA = startA; _G.gi_endA = endA
    _G.gi_startB = startB; _G.gi_endB = endB
    _G.gi_startC = startC; _G.gi_endC = endC
    _G.gi_sA = sA; _G.gi_eA = eA
    _G.gi_sB = sB; _G.gi_eB = eB
    _G.gi_sC = sC; _G.gi_eC = eC

local is_A = (current_char >= sA and current_char <= eA)
local is_B = (current_char >= sB and current_char <= eB)
local is_C = (current_char >= sC and current_char <= eC)

-- ----------------------------------------------------------------
-- 各バッファに文字を描画・蓄積
-- ----------------------------------------------------------------

-- 1. 最前面文字本体用 (全文字蓄積)
obj.copybuffer("tempbuffer", "cache:text_all")
obj.setoption("drawtarget", "tempbuffer")
obj.draw(obj.ox, obj.oy, obj.oz, scale, alpha, obj.rx, obj.ry, obj.rz)
obj.copybuffer("cache:text_all", "tempbuffer")

-- 2. 1段目用 (A or X)
if effectA == 1 then
    if is_A then
        _G.gi_has_A = true
        obj.copybuffer("tempbuffer", "cache:text_A")
        obj.setoption("drawtarget", "tempbuffer")
        obj.draw(obj.ox, obj.oy, obj.oz, scale, alpha, obj.rx, obj.ry, obj.rz)
        obj.copybuffer("cache:text_A", "tempbuffer")
    else
        _G.gi_has_X = true
        obj.copybuffer("tempbuffer", "cache:text_X")
        obj.setoption("drawtarget", "tempbuffer")
        obj.draw(obj.ox, obj.oy, obj.oz, scale, alpha, obj.rx, obj.ry, obj.rz)
        obj.copybuffer("cache:text_X", "tempbuffer")
    end
end

-- 3. 2段目用 (B or Y)
if effectB == 1 then
    if is_B then
        _G.gi_has_B = true
        obj.copybuffer("tempbuffer", "cache:text_B")
        obj.setoption("drawtarget", "tempbuffer")
        obj.draw(obj.ox, obj.oy, obj.oz, scale, alpha, obj.rx, obj.ry, obj.rz)
        obj.copybuffer("cache:text_B", "tempbuffer")
    else
        _G.gi_has_Y = true
        obj.copybuffer("tempbuffer", "cache:text_Y")
        obj.setoption("drawtarget", "tempbuffer")
        obj.draw(obj.ox, obj.oy, obj.oz, scale, alpha, obj.rx, obj.ry, obj.rz)
        obj.copybuffer("cache:text_Y", "tempbuffer")
    end
end

-- 4. 3段目用 (C or Z)
if effectC == 1 then
    if is_C then
        _G.gi_has_C = true
        obj.copybuffer("tempbuffer", "cache:text_C")
        obj.setoption("drawtarget", "tempbuffer")
        obj.draw(obj.ox, obj.oy, obj.oz, scale, alpha, obj.rx, obj.ry, obj.rz)
        obj.copybuffer("cache:text_C", "tempbuffer")
    else
        _G.gi_has_Z = true
        obj.copybuffer("tempbuffer", "cache:text_Z")
        obj.setoption("drawtarget", "tempbuffer")
        obj.draw(obj.ox, obj.oy, obj.oz, scale, alpha, obj.rx, obj.ry, obj.rz)
        obj.copybuffer("cache:text_Z", "tempbuffer")
    end
end

-- ================================================================
-- 描画処理
-- 最後の文字で tempbuffer 上に最奥(3段目) → 2段目 → 1段目 → 本体 を合成し、
-- 完成したバッファを load して元の位置に正確に描画する
-- ================================================================
if idx == obj.num - 1 then
    -- 各段の外側への累計太さを計算
    local t1 = (effectA == 1) and sizeA or 0
    local t2 = t1 + ((effectB == 1) and sizeB or 0)
    local t3 = t2 + ((effectC == 1) and sizeC or 0)

    -- tempbuffer 上にレイヤー順で合成
    obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
    obj.clearbuffer("tempbuffer")

    -- [第3段目] 最奥：Cグループ(C) / 指定外(Z)
    if effectC == 1 and t3 > 0 then
        if _G.gi_has_Z then
            obj.copybuffer("object", "cache:text_Z")
            obj.effect("縁取り", "サイズ", t3, "ぼかし", blurC, "縁色", string.format("%06x", colorZ))
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
        if _G.gi_has_C then
            obj.copybuffer("object", "cache:text_C")
            obj.effect("縁取り", "サイズ", t3, "ぼかし", blurC, "縁色", string.format("%06x", colorC))
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
    end

    -- [第2段目] 中奥：Bグループ(B) / 指定外(Y)
    if effectB == 1 and t2 > 0 then
        if _G.gi_has_Y then
            obj.copybuffer("object", "cache:text_Y")
            obj.effect("縁取り", "サイズ", t2, "ぼかし", blurB, "縁色", string.format("%06x", colorY))
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
        if _G.gi_has_B then
            obj.copybuffer("object", "cache:text_B")
            obj.effect("縁取り", "サイズ", t2, "ぼかし", blurB, "縁色", string.format("%06x", colorB))
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
    end

    -- [第1段目] 手前：Aグループ(A) / 指定外(X)
    if effectA == 1 and t1 > 0 then
        if _G.gi_has_X then
            obj.copybuffer("object", "cache:text_X")
            obj.effect("縁取り", "サイズ", t1, "ぼかし", blurA, "縁色", string.format("%06x", colorX))
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
        if _G.gi_has_A then
            obj.copybuffer("object", "cache:text_A")
            obj.effect("縁取り", "サイズ", t1, "ぼかし", blurA, "縁色", string.format("%06x", colorA))
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
    end

    -- [最前面] 文字本体 (元のテキスト色)
    obj.copybuffer("object", "cache:text_all")
    obj.draw(0, 0, 0, 1, 1, 0, 0, 0)

    -- 完成した合成画像をフレームバッファへロード (AviUtlが本来の位置に描画)
    obj.setoption("drawtarget", "framebuffer")
    obj.load("tempbuffer")
    obj.clearbuffer("tempbuffer")
else
    -- 最後の文字以外は画面に描画しない
    obj.setoption("drawtarget", "framebuffer")
    obj.clearbuffer("object")
end