--hide@shatter_directionC:effectC~=3

-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("振動",
        "X",vib_xA,
        "Y",vib_yA,
        "Z",vib_zA,
        "周期",vib_periodA,
        "ランダムに強さを変える",vib_randA,
        "複雑に振動",vib_complexA
        )
    elseif effectA == 2 then
        obj.effect("震える",
        "振幅",tremble_ampA,
        "角度",tremble_angleA,
        "間隔",tremble_intervalA
        )
    elseif effectA == 3 then
        obj.effect("砕け散る",
        "開始時間",shatter_timeA,
        "再生速度",shatter_playbackspeedA,
        "中心X",shatter_cxA,
        "中心Y",shatter_cyA,
        "中心Z",shatter_czA,
        "破片サイズ",shatter_fragmentA,
        "速度",shatter_speedA,
        "重力",shatter_gravityA,
        "時間差",shatter_lagA,
        "距離影響",shatter_distanceA,
        "ランダム回転",shatter_rotateA,
        "ランダム方向",shatter_directionA
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        obj.effect("振動",
        "X",vib_xB,
        "Y",vib_yB,
        "Z",vib_zB,
        "周期",vib_periodB,
        "ランダムに強さを変える",vib_randB,
        "複雑に振動",vib_complexB
        )
    elseif effectB == 2 then
        obj.effect("震える",
        "振幅",tremble_ampB,
        "角度",tremble_angleB,
        "間隔",tremble_intervalB
        )
    elseif effectB == 3 then
        obj.effect("砕け散る",
        "開始時間",shatter_timeB,
        "再生速度",shatter_playbackspeedB,
        "中心X",shatter_cxB,
        "中心Y",shatter_cyB,
        "中心Z",shatter_czB,
        "破片サイズ",shatter_fragmentB,
        "速度",shatter_speedB,
        "重力",shatter_gravityB,
        "時間差",shatter_lagB,
        "距離影響",shatter_distanceB,
        "ランダム回転",shatter_rotateB,
        "ランダム方向",shatter_directionB
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        obj.effect("振動",
        "X",vib_xC,
        "Y",vib_yC,
        "Z",vib_zC,
        "周期",vib_periodC,
        "ランダムに強さを変える",vib_randC,
        "複雑に振動",vib_complexC
        )
    elseif effectC == 2 then
        obj.effect("震える",
        "振幅",tremble_ampC,
        "角度",tremble_angleC,
        "間隔",tremble_intervalC
        )
    elseif effectC == 3 then
        obj.effect("砕け散る",
        "開始時間",shatter_timeC,
        "再生速度",shatter_playbackspeedC,
        "中心X",shatter_cxC,
        "中心Y",shatter_cyC,
        "中心Z",shatter_czC,
