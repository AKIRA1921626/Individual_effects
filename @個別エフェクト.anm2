        "幅",edge_widthA0,
        "高さ",edge_heightA0,
        "角度",edge_rotateA0
        )
        obj.effect("縁取り",
        "サイズ",frame_sA0,
        "ぼかし",frame_bA0,
        "縁色",frame_colA0
        )
        obj.effect("凸エッジ",
        "幅",edge_widthA1,
        "高さ",edge_heightA1,
        "角度",edge_rotateA1
        )
        obj.effect("縁取り",
        "サイズ",frame_sA1,
        "ぼかし",frame_bA1,
        "縁色",frame_colA1
        )
        obj.effect("凸エッジ",
        "幅",edge_widthA2,
