-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

@個別エフェクト(標準:加工)
--label:個別エフェクト
--information:個別オブジェクトにした文字の中から、指定した範囲(A・B・Cグループ)をそれぞれ1つのオブジェクトとしてまとめ、各グループに個別のエフェクトを適用するスクリプト。グループ外の文字はそのまま表示される。使用できるエフェクトは標準スクリプトの「加工」のみ。

--group:文字のまとめ方,true
--select@pack:方法=0,まとめない=0,範囲外の文字をまとめる=1,すべての文字をまとめる=2
--group

--group:Aグループ
--track@startA:Aグループ::開始A,1,100,1,1
--track@endA:Aグループ::終了A,1,100,1,1
--select@effectA:Aグループ::エフェクト=0,なし=0,画像合成=1,シャープ=2,ノイズ除去=3,インターレース解除=4,ノイズ=5,モザイク=6

--track@p_1_0_A:Aグループ(画像合成)::X,-5000.0,5000.0,0.0,0.1
--track@p_1_1_A:Aグループ(画像合成)::Y,-5000.0,5000.0,0.0,0.1
--track@p_1_2_A:Aグループ(画像合成)::拡大率,0.00,800.00,100.00,0.01
--select@p_1_3_A:Aグループ(画像合成)::合成モード=3,前方から合成=1,後方から合成=2,色情報を上書き=3,輝度をアルファ値として上書き=4,輝度をアルファ値として乗算=5
--file@p_1_4_A:Aグループ(画像合成)::画像
--check@p_1_5_A:Aグループ(画像合成)::ループ画像,1

--track@p_2_0_A:Aグループ(シャープ)::強さ,0.0,800.0,50.0,0.1
--track@p_2_1_A:Aグループ(シャープ)::範囲,0,100,5,1

--track@p_3_0_A:Aグループ(ノイズ除去)::強さ,0.0,100.0,100.0,0.1
--track@p_3_1_A:Aグループ(ノイズ除去)::範囲,1,8,2,1
--track@p_3_2_A:Aグループ(ノイズ除去)::しきい値,0,200,20,1

--select@p_4_0_A:Aグループ(インターレース解除)::解除方法=1,偶数=1,二重化=2

--track@p_5_0_A:Aグループ(ノイズ)::強さ,0.0,200.0,100.0,0.1
--track@p_5_1_A:Aグループ(ノイズ)::速度X,-800.0,800.0,0.0,0.1
--track@p_5_2_A:Aグループ(ノイズ)::速度Y,-800.0,800.0,0.0,0.1
--track@p_5_3_A:Aグループ(ノイズ)::変化速度,0.0,800.0,0.0,0.1
--track@p_5_4_A:Aグループ(ノイズ)::周期X,0.00,100.00,1.00,0.01
--track@p_5_5_A:Aグループ(ノイズ)::周期Y,0.00,100.00,1.00,0.01
--track@p_5_6_A:Aグループ(ノイズ)::しきい値,0.0,100.0,0.0,0.1
--track@p_5_7_A:Aグループ(ノイズ)::シード,0,100,0,1
--select@p_5_8_A:Aグループ(ノイズ)::合成モード=1,アルファ値と乗算=1,明るさと乗算=2
--select@p_5_9_A:Aグループ(ノイズ)::ノイズの種類=1,Type1=1,Type2=2,Type3=3,Type4=4,Type5=5,Type6=6

--track@p_6_0_A:Aグループ(モザイク)::サイズ,1,2000,12,1
--check@p_6_1_A:Aグループ(モザイク)::タイル風,0

--group

--group:Bグループ
--track@startB:Bグループ::開始B,1,100,1,1
--track@endB:Bグループ::終了B,1,100,1,1
