        )
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

@個別エフェクト(標準:切り替え効果)
--label:個別エフェクト
--information:個別オブジェクトにした文字の中から、指定した範囲(A・B・Cグループ)をそれぞれ1つのオブジェクトとしてまとめ、各グループに個別のエフェクトを適用するスクリプト。グループ外の文字はそのまま表示される。使用できるエフェクトは標準スクリプトの「切り替え効果」のみ。

--group:文字のまとめ方,true
--select@pack:方法=0,まとめない=0,範囲外の文字をまとめる=1,すべての文字をまとめる=2
--group

--group:Aグループ
--track@startA:Aグループ::開始A,1,100,1,1
--track@endA:Aグループ::終了A,1,100,1,1
--select@effectA:Aグループ::エフェクト=0,なし=0,フェード=1,ワイプ=2,画面外から登場=3,ランダム方向から登場=4,拡大縮小して登場=5,ランダム間隔で落ちながら登場=6,弾んで登場=7,広がって登場=8,起き上がって登場=9,何処からともなく登場=10,点滅して登場=11

--track@p_1_0_A:Aグループ(フェード)::イン,0.00,10.00,0.50,0.01
