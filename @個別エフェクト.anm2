--hide@hue_inversionC:effectC==0
--hide@transparency_inversionC:effectC==0

-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- アンカーを表示するか非表示にするかをトラックバーで設定
if ankerA ~= 0 then
    obj.setanchor("xA,yA",0,"arm","color",0xff0000)
end
if ankerB ~= 0 then
    obj.setanchor("xB,yB",0,"arm","color",0x00ff00)
end
if ankerC ~= 0 then
    obj.setanchor("xC,yC",0,"arm","color",0x0000ff)
end

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("座標","X",xA,"Y",yA,"Z",zA)
        obj.effect("拡大率","拡大率",100.000 + zoomA,"X",aspect_xA,"Y",aspect_yA,"Z",aspect_zA)
        obj.effect("透明度","透明度",alphaA)
        obj.effect("回転","X",rotate_xA,"Y",rotate_yA,"Z",rotate_zA)
        obj.effect("ローテーション","90度回転",rotationA)
        obj.effect("反転","上下反転",flip_verticallyA,
        "左右反転",horizontal_flipA,
        "輝度反転",luminance_inversionA,
        "色相反転",hue_inversionA,
        "透明度反転",transparency_inversionA
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        obj.effect("座標","X",xB,"Y",yB,"Z",zB)
        obj.effect("拡大率","拡大率",100.000 + zoomB,"X",aspect_xB,"Y",aspect_yB,"Z",aspect_zB)
        obj.effect("透明度","透明度",alphaB)
        obj.effect("回転","X",rotate_xB,"Y",rotate_yB,"Z",rotate_zB)
        obj.effect("ローテーション","90度回転",rotationB)
        obj.effect("反転","上下反転",flip_verticallyB,
        "左右反転",horizontal_flipB,
        "輝度反転",luminance_inversionB,
        "色相反転",hue_inversionB,
        "透明度反転",transparency_inversionB
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
        if effectC == 1 then
           obj.effect("座標","X",xC,"Y",yC,"Z",zC)
           obj.effect("拡大率","拡大率",100.000 + zoomC,"X",aspect_xC,"Y",aspect_yC,"Z",aspect_zC)
           obj.effect("透明度","透明度",alphaC)
           obj.effect("回転","X",rotate_xC,"Y",rotate_yC,"Z",rotate_zC)
           obj.effect("ローテーション","90度回転",rotationC)
           obj.effect("反転","上下反転",flip_verticallyC,
           "左右反転",horizontal_flipC,
           "輝度反転",luminance_inversionC,
           "色相反転",hue_inversionC,
           "透明度反転",transparency_inversionC
            )
        end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

@個別エフェクト(装飾1)
--label:個別エフェクト
--information:個別オブジェクトにした文字の中から、指定した範囲(A・B・Cグループ)をそれぞれ1つのオブジェクトとしてまとめ、各グループに個別のエフェクトを適用するスクリプト。グループ外の文字はそのまま表示される。使用できるエフェクトは各種標準スクリプトの装飾1(こちらで勝手に決めた適当な区分け)のみ。
--group:文字のまとめ方,true
--select@pack:文字のまとめ方=0,まとめない=0,範囲外の文字をまとめる=1,すべての文字をまとめる=2
--group

