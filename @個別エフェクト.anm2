            "拡散", p_5_1_B,
            "比率", p_5_2_B,
            "逆光", p_5_3_B,
        }
        if p_5_4_B ~= nil then table.insert(args, "色"); table.insert(args, p_5_4_B) end
        obj.effect("ライト", unpack(args))
    elseif effectB == 6 then
        obj.effect("色ずれ",
            "ずれ幅", p_6_0_B,
            "角度", p_6_1_B,
            "強さ", p_6_2_B,
            "色ずれの種類", TBL_6_3[p_6_3_B]
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        local args = {
            "強さ", p_1_0_C,
            "拡散", p_1_1_C,
            "角度", p_1_2_C,
            "しきい値", p_1_3_C,
            "比率", p_1_4_C,
            "ぼかし", p_1_5_C,
            "形状", TBL_1_6[p_1_6_C],
            "光成分のみ", p_1_8_C,
            "サイズ固定", p_1_9_C,
        }
        if p_1_7_C ~= nil then table.insert(args, "光色"); table.insert(args, p_1_7_C) end
        obj.effect("グロー", unpack(args))
    elseif effectC == 2 then
        local args = {
            "強さ", p_2_0_C,
            "拡散", p_2_1_C,
            "しきい値", p_2_2_C,
            "拡散速度", p_2_3_C,
            "サイズ固定", p_2_5_C,
        }
        if p_2_4_C ~= nil then table.insert(args, "光色"); table.insert(args, p_2_4_C) end
        obj.effect("発光", unpack(args))
    elseif effectC == 3 then
        local args = {
            "強さ", p_3_0_C,
            "X", p_3_1_C,
            "Y", p_3_2_C,
            "合成モード", TBL_3_3[p_3_3_C],
            "サイズ固定", p_3_5_C,
        }
        if p_3_4_C ~= nil then table.insert(args, "光色"); table.insert(args, p_3_4_C) end
        obj.effect("閃光", unpack(args))
    elseif effectC == 4 then
        obj.effect("拡散光",
            "強さ", p_4_0_C,
            "拡散", p_4_1_C,
            "サイズ固定", p_4_2_C
        )
    elseif effectC == 5 then
        local args = {
            "強さ", p_5_0_C,
            "拡散", p_5_1_C,
            "比率", p_5_2_C,
            "逆光", p_5_3_C,
        }
        if p_5_4_C ~= nil then table.insert(args, "色"); table.insert(args, p_5_4_C) end
        obj.effect("ライト", unpack(args))
    elseif effectC == 6 then
        obj.effect("色ずれ",
            "ずれ幅", p_6_0_C,
            "角度", p_6_1_C,
            "強さ", p_6_2_C,
            "色ずれの種類", TBL_6_3[p_6_3_C]
        )
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

