--hide@border_sC:effectC~=2
--hide@border_rC:effectC~=2
--hide@border_colC:effectC~=2
--hide@drop_shadow_xC:effectC~=3
--hide@drop_shadow_yC:effectC~=3
--hide@drop_shadow_deepC:effectC~=3
--hide@drop_shadow_diffusionC:effectC~=3
--hide@drop_shadow_colorC:effectC~=3
--hide@edge_widthC:effectC~=4
--hide@edge_heightC:effectC~=4
--hide@edge_rotateC:effectC~=4
--hide@grd_powC:effectC~=5
--hide@grd_cxC:effectC~=5
--hide@grd_cyC:effectC~=5
--hide@grd_rotateC:effectC~=5
--hide@grd_widthC:effectC~=5
