            "濃さ", p_3_2_B,
            "拡散", p_3_3_B,
            "影を別オブジェクトで描画", p_3_5_B,
        }
        if p_3_4_B ~= nil then table.insert(args, "影色"); table.insert(args, p_3_4_B) end
        obj.effect("ドロップシャドウ", unpack(args))
    elseif effectB == 4 then
        obj.effect("凸エッジ",
            "幅", p_4_0_B,
            "高さ", p_4_1_B,
            "角度", p_4_2_B
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        local args = {
            "サイズ", p_1_0_C,
            "ぼかし", p_1_1_C,
        }
        if p_1_2_C ~= nil then table.insert(args, "縁色"); table.insert(args, p_1_2_C) end
        if p_1_3_C ~= nil and p_1_3_C ~= "" then table.insert(args, "パターン画像"); table.insert(args, p_1_3_C) end
        obj.effect("縁取り", unpack(args))
    elseif effectC == 2 then
        local args = {
            "X", p_2_0_C,
