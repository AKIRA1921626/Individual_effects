-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- アンカーを表示するか非表示にするかをトラックバーで設定
if ankerA ~= 0 then
    obj.setanchor("entry_xA,entry_yA",0,"arm","color",0xff0000)
end
if ankerB ~= 0 then
    obj.setanchor("entry_xB,entry_yB",0,"arm","color",0x00ff00)
end
if ankerC ~= 0 then
    obj.setanchor("entry_xC,entry_yC",0,"arm","color",0x0000ff)
end

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("移動登場と退場_AKIRA",
            "登退場秒数",entry_timeA,
            "登場秒数",in_timeA,
            "退場秒数",out_timeA,
            "X",entry_xA,
            "Y",entry_yA,
            "Z",entry_zA,
            "拡大率",entry_zoomA,
            "X拡大率",entry_aspect_xA,
            "Y拡大率",entry_aspect_yA,
            "Z拡大率",entry_aspect_zA,
            "X回転",entry_rotate_xA,
            "Y回転",entry_rotate_yA,
            "Z回転",entry_rotate_zA,
            "登場順",0,
            "間隔",0,
            "イージングタイプ",entry_easingA,
            "登場",entry_inA,
            "退場",entry_outA,
            "INフェード",entry_in_fadeA,
            "インフェード時間",in_fade_timeA,
            "OUTフェード",entry_out_fadeA,
            "アウトフェード時間",out_fade_timeA
        )
    elseif effectA == 2 then
        obj.effect("発光登退場_AKIRA@各種登退場_AKIRA",
            "登退場秒数",entry_timeA,
            "登場秒数",in_timeA,
            "退場秒数",out_timeA,
            "強さ",entry_strengthA,
            "拡散",glow_diffusionA,
            "しきい値",glow_thresholdA,
            "拡散速度",glow_speedA,
            "サイズ固定",glow_fix_sizeA,
            "光色",glow_colorA,
            "登場順",0,
            "間隔",0,
            "イージングタイプ",entry_easingA,
            "登場",entry_inA,
            "退場",entry_outA,
            "INフェード",entry_in_fadeA,
            "インフェード時間",in_fade_timeA,
            "OUTフェード",entry_out_fadeA,
            "アウトフェード時間",out_fade_timeA
        )
    elseif effectA == 3 then
        obj.effect("クリッピング登退場_AKIRA@各種登退場_AKIRA",
            "登退場秒数",entry_timeA,
            "登場秒数",in_timeA,
            "退場秒数",out_timeA,
            "上", entry_clip_uA,
            "下", entry_clip_dA,
            "左", entry_clip_lA,
            "右", entry_clip_rA,
            "中心の位置を固定", clip_centerA,
            "登場順",0,
            "間隔",0,
            "イージングタイプ",entry_easingA,
            "登場",entry_inA,
            "退場",entry_outA,
            "INフェード",entry_in_fadeA,
            "インフェード時間",in_fade_timeA,
            "OUTフェード",entry_out_fadeA,
            "アウトフェード時間",out_fade_timeA
        )
    elseif effectA == 4 then
        obj.effect("波紋登退場_AKIRA@各種登退場_AKIRA",
            "登退場秒数",entry_timeA,
            "登場秒数",in_timeA,
            "退場秒数",out_timeA,
            "高さ", entry_ripples_heightA,
            "中心X", ripple_cxA,
            "中心Y", ripple_cyA,
            "幅", ripple_wA,
            "速度", ripple_speedA,
            "波紋数", ripple_countA,
            "波紋間隔", ripple_intervalA,
            "増幅減衰回数", ripple_ampA,
            "登場順",0,
            "間隔",0,
            "イージングタイプ",entry_easingA,
            "登場",entry_inA,
            "退場",entry_outA,
            "INフェード",entry_in_fadeA,
            "インフェード時間",in_fade_timeA,
            "OUTフェード",entry_out_fadeA,
            "アウトフェード時間",out_fade_timeA
        )
    elseif effectA == 5 then
        obj.effect("ラスター登退場_AKIRA@各種登退場_AKIRA",
            "登退場秒数",entry_timeA,
            "登場秒数",in_timeA,
            "退場秒数",out_timeA,
            "高さ", entry_raster_heightA,
            "横幅", raster_wA,
            "周期", raster_periodA,
            "縦ラスター", raster_vA,
            "ランダム振幅", raster_randA,
            "登場順",0,
            "間隔",0,
            "イージングタイプ",entry_easingA,
            "登場",entry_inA,
            "退場",entry_outA,
            "INフェード",entry_in_fadeA,
            "インフェード時間",in_fade_timeA,
            "OUTフェード",entry_out_fadeA,
            "アウトフェード時間",out_fade_timeA
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

