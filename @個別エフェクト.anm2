-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("グラデーション",
        "強さ",grd_powA,
        "中心X",grd_cxA,
        "中心Y",grd_cyA,
        "角度",grd_rotateA,
        "幅",grd_widthA,
        "合成モード","通常",
        "形状","線形",
        "開始色",grd_start_colA,
        "終了色",grd_end_colA
        )
        obj.effect("凸エッジ",
        "幅",edge_widthA0,
        "高さ",edge_heightA0,
        "角度",edge_rotateA0
        )
    elseif effectA == 2 then
        obj.effect("グラデーション",
        "強さ",grd_powA,
        "中心X",grd_cxA,
        "中心Y",grd_cyA,
        "角度",grd_rotateA,
        "幅",grd_widthA,
        "合成モード","通常",
        "形状","線形",
        "開始色",grd_start_colA,
        "終了色",grd_end_colA
        )
        obj.effect("凸エッジ",
        "幅",edge_widthA0,
        "高さ",edge_heightA0,
        "角度",edge_rotateA0
        )
        obj.effect("縁取り",
        "サイズ",frame_sA0,
        "ぼかし",frame_bA0,
        "縁色",frame_colA0
        )
        obj.effect("凸エッジ",
        "幅",edge_widthA1,
        "高さ",edge_heightA1,
        "角度",edge_rotateA1
        )
