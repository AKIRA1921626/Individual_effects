-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- selectの数字を文字列に変換するテーブル
local TBL_1_6 = {"通常", "クロス(4本)", "クロス(6本)", "クロス(8本)", "クロス(10本)", "クロス(12本)", "ライン"}
local TBL_3_3 = {"前方に合成", "後方に合成", "光成分のみ"}
local TBL_6_3 = {"赤緑A", "赤青A", "緑青A", "赤緑B", "赤青B", "緑青B"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        local args = {
            "強さ", p_1_0_A,
            "拡散", p_1_1_A,
            "角度", p_1_2_A,
            "しきい値", p_1_3_A,
            "比率", p_1_4_A,
            "ぼかし", p_1_5_A,
            "形状", TBL_1_6[p_1_6_A],
            "光成分のみ", p_1_8_A,
            "サイズ固定", p_1_9_A,
        }
        if p_1_7_A ~= nil then table.insert(args, "光色"); table.insert(args, p_1_7_A) end
        obj.effect("グロー", unpack(args))
    elseif effectA == 2 then
        local args = {
            "強さ", p_2_0_A,
            "拡散", p_2_1_A,
            "しきい値", p_2_2_A,
            "拡散速度", p_2_3_A,
            "サイズ固定", p_2_5_A,
        }
        if p_2_4_A ~= nil then table.insert(args, "光色"); table.insert(args, p_2_4_A) end
        obj.effect("発光", unpack(args))
    elseif effectA == 3 then
        local args = {
            "強さ", p_3_0_A,
            "X", p_3_1_A,
            "Y", p_3_2_A,
            "合成モード", TBL_3_3[p_3_3_A],
            "サイズ固定", p_3_5_A,
        }
        if p_3_4_A ~= nil then table.insert(args, "光色"); table.insert(args, p_3_4_A) end
        obj.effect("閃光", unpack(args))
    elseif effectA == 4 then
        obj.effect("拡散光",
            "強さ", p_4_0_A,
            "拡散", p_4_1_A,
            "サイズ固定", p_4_2_A
        )
    elseif effectA == 5 then
        local args = {
            "強さ", p_5_0_A,
            "拡散", p_5_1_A,
            "比率", p_5_2_A,
            "逆光", p_5_3_A,
        }
        if p_5_4_A ~= nil then table.insert(args, "色"); table.insert(args, p_5_4_A) end
        obj.effect("ライト", unpack(args))
    elseif effectA == 6 then
        obj.effect("色ずれ",
            "ずれ幅", p_6_0_A,
            "角度", p_6_1_A,
            "強さ", p_6_2_A,
            "色ずれの種類", TBL_6_3[p_6_3_A]
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

