-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})



@個別エフェクト(アニメーション1)
--label:個別エフェクト
--information:個別オブジェクトにした文字の中から、指定した範囲(A・B・Cグループ)をそれぞれ1つのオブジェクトとしてまとめ、各グループに個別のエフェクトを適用するスクリプト。グループ外の文字はそのまま表示される。使用できるエフェクトは各種標準スクリプト、及び、外部スクリプトのアニメーション1(こちらで勝手に決めた適当な区分け)のみ。

--group:文字のまとめ方,true
--select@pack:方法=0,まとめない=0,範囲外の文字をまとめる=1,すべての文字をまとめる=2
--group

--group:Aグループ
--track@startA:Aグループ::開始A,1,100,1,1
--track@endA:Aグループ::終了A,1,100,1,1
--select@effectA:Aグループ::アニメーション=0,なし=0,移動登場と退場_AKIRA=1,発光登退場_AKIRA=2,クリッピング登退場_AKIRA=3,波紋登退場_AKIRA=4,ラスター登退場_AKIRA=5
