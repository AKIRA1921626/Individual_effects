local function apply_effect_C()
    if effectC == 1 then
        obj.effect("座標",
            "X", p_1_0_C,
            "Y", p_1_1_C,
            "Z", p_1_2_C
        )
    elseif effectC == 2 then
        obj.effect("拡大率",
            "拡大率", p_2_0_C,
            "X", p_2_1_C,
            "Y", p_2_2_C,
            "Z", p_2_3_C
        )
    elseif effectC == 3 then
        obj.effect("透明度",
            "透明度", p_3_0_C
        )
    elseif effectC == 4 then
        obj.effect("回転",
            "X", p_4_0_C,
            "Y", p_4_1_C,
            "Z", p_4_2_C
        )
    elseif effectC == 5 then
        obj.effect("領域拡張",
            "上", p_5_0_C,
            "下", p_5_1_C,
            "左", p_5_2_C,
            "右", p_5_3_C,
            "塗りつぶし", p_5_4_C
        )
    elseif effectC == 6 then
        obj.effect("ローテーション",
            "90度回転", p_6_0_C
        )
    elseif effectC == 7 then
        obj.effect("反転",
            "上下反転", p_7_0_C,
            "左右反転", p_7_1_C,
            "輝度反転", p_7_2_C,
            "色相反転", p_7_3_C,
            "透明度反転", p_7_4_C
        )
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})
