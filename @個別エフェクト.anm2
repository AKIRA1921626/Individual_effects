        "縁色",frame_colA0
        )
        obj.effect("凸エッジ",
        "幅",edge_widthA1,
        "高さ",edge_heightA1,
        "角度",edge_rotateA1
        )
        obj.effect("縁取り",
        "サイズ",frame_sA1,
        "ぼかし",frame_bA1,
        "縁色",frame_colA1
        )
        obj.effect("凸エッジ",
        "幅",edge_widthA2,
        "高さ",edge_heightA2,
        "角度",edge_rotateA2
        )
    elseif effectA == 4 then
        obj.effect("グラデーション",
        "強さ",grd_powA,
        "中心X",grd_cxA,
        "中心Y",grd_cyA,
        "角度",grd_rotateA,
        "幅",grd_widthA,
