-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- selectの数字を文字列に変換するテーブル
local TBL_4_6 = {"円", "四角形", "三角形", "五角形", "六角形", "星型", "ハート", "仮想バッファ", "(ファイルから選択)"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("クリッピング",
            "上", p_1_0_A,
            "下", p_1_1_A,
            "左", p_1_2_A,
            "右", p_1_3_A,
            "中心の位置を変更", p_1_4_A
        )
    elseif effectA == 2 then
        obj.effect("斜めクリッピング",
            "中心X", p_2_0_A,
            "中心Y", p_2_1_A,
            "角度", p_2_2_A,
            "ぼかし", p_2_3_A,
            "幅", p_2_4_A
        )
    elseif effectA == 3 then
        obj.effect("扇クリッピング",
            "中心X", p_3_0_A,
            "中心Y", p_3_1_A,
            "基準角", p_3_2_A,
            "範囲角", p_3_3_A,
            "ぼかし", p_3_4_A,
            "基準角を中央にする", p_3_5_A
        )
    elseif effectA == 4 then
        obj.effect("マスク",
            "X", p_4_0_A,
            "Y", p_4_1_A,
            "回転", p_4_2_A,
            "サイズ", p_4_3_A,
            "縦横比", p_4_4_A,
            "ぼかし", p_4_5_A,
            "マスクの種類", TBL_4_6[p_4_6_A],
            "マスクの反転", p_4_7_A,
            "元のサイズに合わせる", p_4_8_A
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        obj.effect("クリッピング",
            "上", p_1_0_B,
            "下", p_1_1_B,
            "左", p_1_2_B,
            "右", p_1_3_B,
            "中心の位置を変更", p_1_4_B
        )
    elseif effectB == 2 then
        obj.effect("斜めクリッピング",
            "中心X", p_2_0_B,
            "中心Y", p_2_1_B,
            "角度", p_2_2_B,
            "ぼかし", p_2_3_B,
            "幅", p_2_4_B
        )
    elseif effectB == 3 then
        obj.effect("扇クリッピング",
            "中心X", p_3_0_B,
            "中心Y", p_3_1_B,
            "基準角", p_3_2_B,
            "範囲角", p_3_3_B,
            "ぼかし", p_3_4_B,
            "基準角を中央にする", p_3_5_B
        )
    elseif effectB == 4 then
        obj.effect("マスク",
            "X", p_4_0_B,
            "Y", p_4_1_B,
            "回転", p_4_2_B,
            "サイズ", p_4_3_B,
            "縦横比", p_4_4_B,
            "ぼかし", p_4_5_B,
            "マスクの種類", TBL_4_6[p_4_6_B],
            "マスクの反転", p_4_7_B,
            "元のサイズに合わせる", p_4_8_B
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        obj.effect("クリッピング",
            "上", p_1_0_C,
            "下", p_1_1_C,
            "左", p_1_2_C,
            "右", p_1_3_C,
            "中心の位置を変更", p_1_4_C
        )
    elseif effectC == 2 then
        obj.effect("斜めクリッピング",
            "中心X", p_2_0_C,
            "中心Y", p_2_1_C,
            "角度", p_2_2_C,
            "ぼかし", p_2_3_C,
            "幅", p_2_4_C
        )
    elseif effectC == 3 then
        obj.effect("扇クリッピング",
            "中心X", p_3_0_C,
            "中心Y", p_3_1_C,
            "基準角", p_3_2_C,
            "範囲角", p_3_3_C,
            "ぼかし", p_3_4_C,
            "基準角を中央にする", p_3_5_C
        )
    elseif effectC == 4 then
        obj.effect("マスク",
            "X", p_4_0_C,
            "Y", p_4_1_C,
            "回転", p_4_2_C,
            "サイズ", p_4_3_C,
            "縦横比", p_4_4_C,
            "ぼかし", p_4_5_C,
            "マスクの種類", TBL_4_6[p_4_6_C],
            "マスクの反転", p_4_7_C,
            "元のサイズに合わせる", p_4_8_C
        )
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

