        if p_2_5_B ~= nil and p_2_5_B ~= "" then table.insert(args, "パターン画像"); table.insert(args, p_2_5_B) end
        obj.effect("枠線", unpack(args))
    elseif effectB == 3 then
        local args = {
            "X", p_3_0_B,
