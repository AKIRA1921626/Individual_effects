-- ヘルパーモジュールの読み込みを試行
local condition, AKIRA_helper = pcall(require, "AKIRA_aviutl2_helper")
local AKIRA_h = nil
if condition then
    AKIRA_h = AKIRA_helper
else
    debug_print("AKIRA_aviutl2_helper.luaが同じフォルダに存在しません。")
end

-- 個別オブジェクトが有効かを確認
local is_multi = obj.getoption("multi_object")
if not is_multi then
    debug_print("個別オブジェクトが有効ではないため、「個別エフェクトまとめる」処理をスキップします。")
    return
end

-- ================================================================
-- グローバル変数の初期化 (index == 0 のときリセット)
-- 各文字の位置・変形情報をここに蓄積していく
-- ================================================================
if obj.index == 0 then
    _G.gi_ox    = {}  -- 各文字の obj.ox
    _G.gi_oy    = {}  -- 各文字の obj.oy
    _G.gi_oz    = {}  -- 各文字の obj.oz
    _G.gi_scale = {}  -- 各文字の obj.sx (拡大率)
    _G.gi_alpha = {}  -- 各文字の alpha
    _G.gi_rx    = {}  -- 各文字の obj.rx
    _G.gi_ry    = {}  -- 各文字の obj.ry
    _G.gi_rz    = {}  -- 各文字の obj.rz
end

-- ----------------------------------------------------------------
-- まず、現在の文字の位置・変形情報をグローバル変数に保存する
-- ----------------------------------------------------------------
local idx   = obj.index
local last = obj.num-1
local scale = obj.sx
local alpha = obj.getvalue("alpha")

_G.gi_ox[idx]    = obj.ox
_G.gi_oy[idx]    = obj.oy
_G.gi_oz[idx]    = obj.oz
_G.gi_scale[idx] = scale
_G.gi_alpha[idx] = alpha
_G.gi_rx[idx]    = obj.rx
_G.gi_ry[idx]    = obj.ry
_G.gi_rz[idx]    = obj.rz

-- グループ範囲の正規化 (逆順指定でも正しく動くよう min/max で補正)
local sA = math.min(startA, endA)  -- Aグループ開始 (1-based)
local eA = math.max(startA, endA)  -- Aグループ終了 (1-based)
local sB = math.min(startB, endB)  -- Bグループ開始 (1-based)
local eB = math.max(startB, endB)  -- Bグループ終了 (1-based)
local sC = math.min(startC, endC)  -- Bグループ開始 (1-based)
local eC = math.max(startC, endC)  -- Bグループ終了 (1-based)

-- 現在の文字番号 (1-based)
local current_char = idx + 1

-- グループ判定
local inA = (current_char >= sA and current_char <= eA)
local inB = (current_char >= sB and current_char <= eB)
local inC = (current_char >= sC and current_char <= eC)

-- 各グループのオブジェクトのサイズ
-- ここに変数を作成する

-- ================================================================
-- 合成バッファのサイズを取得
-- テキスト全体が収まるサイズ (各文字を ox,oy で配置できるよう全体サイズが必要)
-- ================================================================
local full_w = obj.screen_w
local full_h = obj.screen_h
if AKIRA_h then
    local tw, th = AKIRA_h.get_text_size()
    local lc     = AKIRA_h.line_break_confirmation()
    full_w = math.min(obj.screen_w, tw)
    full_h = math.min(obj.screen_h, th * lc)
end

-- ================================================================
-- アンカーを表示するか非表示にするかをトラックバーで設定
-- ================================================================
if ankerA ~= 0 then
    obj.setanchor("entry_xA,entry_yA",0,"arm","color",0xff0000)
end
if ankerB ~= 0 then
    obj.setanchor("entry_xB,entry_yB",0,"arm","color",0x00ff00)
end
if ankerC ~= 0 then
    obj.setanchor("entry_xC,entry_yC",0,"arm","color",0x0000ff)
end

-- ================================================================
-- グループAの処理
-- ================================================================
if inA then

    if current_char < eA then
        -- --------------------------------------------------------
        -- 【Aグループ: 非終了文字の処理】
        -- 仮想バッファ(フルサイズ)を新規作成し、
        -- 保存した ox,oy の位置にこの文字を描画して cache に保存する
        -- --------------------------------------------------------

        -- フルサイズの仮想バッファを新規作成・クリア
        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        -- グローバル変数に保存した ox,oy の位置に描画
        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        -- 仮想バッファをキャッシュに保存 ("cache:gi_A_インデックス" の形式)
        obj.copybuffer("cache:gi_A_" .. idx, "tempbuffer")

        -- この文字は cache に保存したので framebuffer には描画しない (alpha=0 で不可視)
        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")
        obj.clearbuffer("object")

        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","startA")

    elseif current_char == eA then
        -- --------------------------------------------------------
        -- 【Aグループ: 終了文字の処理】
        -- フルサイズの仮想バッファを新規作成し、
        -- 1) 終了文字を ox,oy に描画
        -- 2) これまでの全 cache を各文字の保存済み ox,oy で描画
        -- 3) 仮想バッファを load してエフェクトを適用し framebuffer に描画
        -- --------------------------------------------------------

        -- フルサイズの仮想バッファを新規作成・クリア
        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        -- (1) 終了文字(現在の文字)の ox,oy をグローバルに保存し、その位置に描画
        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        -- (2) 開始文字 ～ 終了文字の1つ前 までのキャッシュを順番に描画
        --     各キャッシュはフルサイズ画像として ox,oy が既に適用されているため
        --     (0,0,0, 1,1, 0,0,0) でそのまま合成する
        for i = sA - 1, eA - 2 do  -- 0-based index: sA-1 から eA-2 まで
            obj.copybuffer("object","cache:gi_A_" .. i)
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end

        -- (3) 合成した仮想バッファを framebuffer に描画 (エフェクト適用)
        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")

        -- ↓ Aグループへのエフェクト適用 ↓
        if effectA == 1 then
           obj.effect("移動登場と退場_AKIRA",
                "登退場秒数",entry_timeA,
                "登場秒数",in_timeA,
                "退場秒数",out_timeA,
                "X",entry_xA,
                "Y",entry_yA,
                "Z",entry_zA,
                "拡大率",entry_zoomA,
                "X拡大率",entry_aspect_xA,
                "Y拡大率",entry_aspect_yA,
                "Z拡大率",entry_aspect_zA,
                "X回転",entry_rotate_xA,
                "Y回転",entry_rotate_yA,
                "Z回転",entry_rotate_zA,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingA,
                "INフェード",entry_in_fadeA,
                "インフェード時間",in_fade_timeA,
                "OUTフェード",entry_out_fadeA,
                "アウトフェード時間",out_fade_timeA
            )
        elseif effectA == 2 then
            obj.effect("発光登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeA,
                "登場秒数",in_timeA,
                "退場秒数",out_timeA,
                "強さ",entry_strengthA,
                "拡散",glow_diffusionA,
                "しきい値",glow_thresholdA,
                "拡散速度",glow_speedA,
                "サイズ固定",glow_fix_sizeA,
                "光色",glow_colorA,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingA,
                "INフェード",entry_in_fadeA,
                "インフェード時間",in_fade_timeA,
                "OUTフェード",entry_out_fadeA,
                "アウトフェード時間",out_fade_timeA
            )
        elseif effectA == 3 then
            obj.effect("クリッピング登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeA,
                "登場秒数",in_timeA,
                "退場秒数",out_timeA,
                "上", entry_clip_uA,
                "下", entry_clip_dA,
                "左", entry_clip_lA,
                "右", entry_clip_rA,
                "中心の位置を固定", clip_centerA,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingA,
                "INフェード",entry_in_fadeA,
                "インフェード時間",in_fade_timeA,
                "OUTフェード",entry_out_fadeA,
                "アウトフェード時間",out_fade_timeA
            )
        elseif effectA == 4 then
            obj.effect("波紋登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeA,
                "登場秒数",in_timeA,
                "退場秒数",out_timeA,
                "高さ", entry_ripples_heightA,
                "中心X", ripple_cxA,
                "中心Y", ripple_cyA,
                "幅", ripple_wA,
                "速度", ripple_speedA,
                "波紋数", ripple_countA,
                "波紋間隔", ripple_intervalA,
                "増幅減衰回数", ripple_ampA,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingA,
                "INフェード",entry_in_fadeA,
                "インフェード時間",in_fade_timeA,
                "OUTフェード",entry_out_fadeA,
                "アウトフェード時間",out_fade_timeA
            )
        elseif effectA == 5 then
            obj.effect("ラスター登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeA,
                "登場秒数",in_timeA,
                "退場秒数",out_timeA,
                "高さ", entry_raster_heightA,
                "横幅", raster_wA,
                "周期", raster_periodA,
                "縦ラスター", raster_vA,
                "ランダム振幅", raster_randA,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingA,
                "INフェード",entry_in_fadeA,
                "インフェード時間",in_fade_timeA,
                "OUTフェード",entry_out_fadeA,
                "アウトフェード時間",out_fade_timeA
            )
        end
        -- ↑ エフェクト追加ここまで ↑

        obj.clearbuffer("tempbuffer")
        
        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","endA")

    end

-- ================================================================
-- グループBの処理
-- ================================================================
elseif inB then

    if current_char < eB then
        -- --------------------------------------------------------
        -- 【Bグループ: 非終了文字の処理】
        -- グループAと同じロジック
        -- --------------------------------------------------------

        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        obj.copybuffer("cache:gi_B_" .. idx, "tempbuffer")

        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")
        obj.clearbuffer("object")
        
        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","startB")

    elseif current_char == eB then
        -- --------------------------------------------------------
        -- 【Bグループ: 終了文字の処理】
        -- グループAと同じロジック
        -- --------------------------------------------------------

        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        for i = sB - 1, eB - 2 do  -- 0-based index: sB-1 から eB-2 まで
            obj.copybuffer("object","cache:gi_B_" .. i)
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end

        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")

        -- ↓ Bグループへのエフェクト適用 ↓
        if effectB == 1 then
           obj.effect("移動登場と退場_AKIRA",
                "登退場秒数",entry_timeB,
                "登場秒数",in_timeB,
                "退場秒数",out_timeB,
                "X",entry_xB,
                "Y",entry_yB,
                "Z",entry_zB,
                "拡大率",entry_zoomB,
                "X拡大率",entry_aspect_xA,
                "Y拡大率",entry_aspect_yB,
                "Z拡大率",entry_aspect_zB,
                "X回転",entry_rotate_xB,
                "Y回転",entry_rotate_yB,
                "Z回転",entry_rotate_zB,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingB,
                "INフェード",entry_in_fadeB,
                "インフェード時間",in_fade_timeB,
                "OUTフェード",entry_out_fadeB,
                "アウトフェード時間",out_fade_timeB
            )
        elseif effectB == 2 then
            obj.effect("発光登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeB,
                "登場秒数",in_timeB,
                "退場秒数",out_timeB,
                "強さ",entry_strengthB,
                "拡散",glow_diffusionB,
                "しきい値",glow_thresholdB,
                "拡散速度",glow_speedB,
                "サイズ固定",glow_fix_sizeB,
                "光色",glow_colorB,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingB,
                "INフェード",entry_in_fadeB,
                "インフェード時間",in_fade_timeB,
                "OUTフェード",entry_out_fadeB,
                "アウトフェード時間",out_fade_timeB
            )
        elseif effectB == 3 then
            obj.effect("クリッピング登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeB,
                "登場秒数",in_timeB,
                "退場秒数",out_timeB,
                "上", entry_clip_uB,
                "下", entry_clip_dB,
                "左", entry_clip_lB,
                "右", entry_clip_rB,
                "中心の位置を固定", clip_centerB,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingB,
                "INフェード",entry_in_fadeB,
                "インフェード時間",in_fade_timeB,
                "OUTフェード",entry_out_fadeB,
                "アウトフェード時間",out_fade_timeB
            )
        elseif effectB == 4 then
            obj.effect("波紋登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeB,
                "登場秒数",in_timeB,
                "退場秒数",out_timeB,
                "高さ", entry_ripples_heightB,
                "中心X", ripple_cxB,
                "中心Y", ripple_cyB,
                "幅", ripple_wB,
                "速度", ripple_speedB,
                "波紋数", ripple_countB,
                "波紋間隔", ripple_intervalB,
                "増幅減衰回数", ripple_ampB,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingB,
                "INフェード",entry_in_fadeB,
                "インフェード時間",in_fade_timeB,
                "OUTフェード",entry_out_fadeB,
                "アウトフェード時間",out_fade_timeB
            )
        elseif effectB == 5 then
            obj.effect("ラスター登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeB,
                "登場秒数",in_timeB,
                "退場秒数",out_timeB,
                "高さ", entry_raster_heightB,
                "横幅", raster_wB,
                "周期", raster_periodB,
                "縦ラスター", raster_vB,
                "ランダム振幅", raster_randB,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingB,
                "INフェード",entry_in_fadeB,
                "インフェード時間",in_fade_timeB,
                "OUTフェード",entry_out_fadeB,
                "アウトフェード時間",out_fade_timeB
            )
        end
        -- ↑ エフェクト追加ここまで ↑

        obj.clearbuffer("tempbuffer")
        
        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","endB")

    end

-- ================================================================
-- グループCの処理
-- ================================================================
elseif inC then

    if current_char < eC then
        -- --------------------------------------------------------
        -- 【Cグループ: 非終了文字の処理】
        -- グループAと同じロジック
        -- --------------------------------------------------------

        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        obj.copybuffer("cache:gi_C_" .. idx, "tempbuffer")

        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")
        obj.clearbuffer("object")
        
        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","startC")

    elseif current_char == eC then
        -- --------------------------------------------------------
        -- 【Cグループ: 終了文字の処理】
        -- グループAと同じロジック
        -- --------------------------------------------------------

        obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
        obj.clearbuffer("tempbuffer")

        obj.draw(
            _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
            _G.gi_scale[idx], _G.gi_alpha[idx],
            _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
        )

        for i = sC - 1, eC - 2 do  -- 0-based index: sC-1 から eC-2 まで
            obj.copybuffer("object","cache:gi_C_" .. i)
            obj.draw(0, 0, 0, 1, 1, 0, 0, 0)
        end
        
        obj.setoption("drawtarget", "framebuffer")
        obj.load("tempbuffer")


        -- ↓ Cグループへのエフェクト適用 ↓
        if effectC == 1 then
           obj.effect("移動登場と退場_AKIRA",
                "登退場秒数",entry_timeC,
                "登場秒数",in_timeC,
                "退場秒数",out_timeC,
                "X",entry_xC,
                "Y",entry_yC,
                "Z",entry_zC,
                "拡大率",entry_zoomC,
                "X拡大率",entry_aspect_xC,
                "Y拡大率",entry_aspect_yC,
                "Z拡大率",entry_aspect_zC,
                "X回転",entry_rotate_xC,
                "Y回転",entry_rotate_yC,
                "Z回転",entry_rotate_zC,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingC,
                "INフェード",entry_in_fadeC,
                "インフェード時間",in_fade_timeC,
                "OUTフェード",entry_out_fadeC,
                "アウトフェード時間",out_fade_timeC
            )
        elseif effectC == 2 then
            obj.effect("発光登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeC,
                "登場秒数",in_timeC,
                "退場秒数",out_timeC,
                "強さ",entry_strengthC,
                "拡散",glow_diffusionC,
                "しきい値",glow_thresholdC,
                "拡散速度",glow_speedC,
                "サイズ固定",glow_fix_sizeC,
                "光色",glow_colorC,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingC,
                "INフェード",entry_in_fadeC,
                "インフェード時間",in_fade_timeC,
                "OUTフェード",entry_out_fadeC,
                "アウトフェード時間",out_fade_timeC
            )
        elseif effectC == 3 then
            obj.effect("クリッピング登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeC,
                "登場秒数",in_timeC,
                "退場秒数",out_timeC,
                "上", entry_clip_uC,
                "下", entry_clip_dC,
                "左", entry_clip_lC,
                "右", entry_clip_rC,
                "中心の位置を固定", clip_centerC,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingC,
                "INフェード",entry_in_fadeC,
                "インフェード時間",in_fade_timeC,
                "OUTフェード",entry_out_fadeC,
                "アウトフェード時間",out_fade_timeC
            )
        elseif effectC == 4 then
            obj.effect("波紋登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeC,
                "登場秒数",in_timeC,
                "退場秒数",out_timeC,
                "高さ", entry_ripples_heightC,
                "中心X", ripple_cxC,
                "中心Y", ripple_cyC,
                "幅", ripple_wC,
                "速度", ripple_speedC,
                "波紋数", ripple_countC,
                "波紋間隔", ripple_intervalC,
                "増幅減衰回数", ripple_ampC,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingC,
                "INフェード",entry_in_fadeC,
                "インフェード時間",in_fade_timeC,
                "OUTフェード",entry_out_fadeC,
                "アウトフェード時間",out_fade_timeC
            )
        elseif effectC == 5 then
            obj.effect("ラスター登退場_AKIRA@各種登退場_AKIRA",
                "登退場秒数",entry_timeC,
                "登場秒数",in_timeC,
                "退場秒数",out_timeC,
                "高さ", entry_raster_heightC,
                "横幅", raster_wC,
                "周期", raster_periodC,
                "縦ラスター", raster_vC,
                "ランダム振幅", raster_randC,
                "登場順",0,
                "間隔",0,
                "イージングタイプ",entry_easingC,
                "INフェード",entry_in_fadeC,
                "インフェード時間",in_fade_timeC,
                "OUTフェード",entry_out_fadeC,
                "アウトフェード時間",out_fade_timeC
            )
        end
        -- ↑ エフェクト追加ここまで ↑

        obj.clearbuffer("tempbuffer")
        
        -- デバッグ用の記述(配布時にはコメントアウトする)
        -- debug_print(current_char.."文字目","endC")

    end


-- ================================================================
-- グループ外の文字: そのまま tempbuffer に通常描画
-- ================================================================
elseif idx <= last then
    obj.setoption("drawtarget", "tempbuffer", full_w, full_h)
    obj.draw(
        _G.gi_ox[idx], _G.gi_oy[idx], _G.gi_oz[idx],
        _G.gi_scale[idx], _G.gi_alpha[idx],
        _G.gi_rx[idx], _G.gi_ry[idx], _G.gi_rz[idx]
    )
    obj.load("tempbuffer")

    obj.clearbuffer("tempbuffer")
        
    -- デバッグ用の記述(配布時にはコメントアウトする)
    -- debug_print(current_char.."文字目","elseif")
else
        
    -- デバッグ用の記述(配布時にはコメントアウトする)
    -- debug_print(current_char.."文字目","else")
    return
end
