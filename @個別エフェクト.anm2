--hide@p_6_1_C:effectC~=6

-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- selectの数字を文字列に変換するテーブル
local TBL_1_3 = {"前方から合成", "後方から合成", "色情報を上書き", "輝度をアルファ値として上書き", "輝度をアルファ値として乗算"}
local TBL_4_0 = {"偶数", "二重化"}
local TBL_5_8 = {"アルファ値と乗算", "明るさと乗算"}
local TBL_5_9 = {"Type1", "Type2", "Type3", "Type4", "Type5", "Type6"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        local args = {
            "X", p_1_0_A,
            "Y", p_1_1_A,
            "拡大率", p_1_2_A,
            "合成モード", TBL_1_3[p_1_3_A],
            "ループ画像", p_1_5_A,
        }
        if p_1_4_A ~= nil and p_1_4_A ~= "" then table.insert(args, "画像"); table.insert(args, p_1_4_A) end
        obj.effect("画像合成", unpack(args))
    elseif effectA == 2 then
        obj.effect("シャープ",
            "強さ", p_2_0_A,
            "範囲", p_2_1_A
        )
    elseif effectA == 3 then
        obj.effect("ノイズ除去",
            "強さ", p_3_0_A,
            "範囲", p_3_1_A,
            "しきい値", p_3_2_A
        )
    elseif effectA == 4 then
        obj.effect("インターレース解除",
            "解除方法", TBL_4_0[p_4_0_A]
        )
    elseif effectA == 5 then
        obj.effect("ノイズ",
            "強さ", p_5_0_A,
            "速度X", p_5_1_A,
            "速度Y", p_5_2_A,
            "変化速度", p_5_3_A,
            "周期X", p_5_4_A,
            "周期Y", p_5_5_A,
            "しきい値", p_5_6_A,
            "シード", p_5_7_A,
            "合成モード", TBL_5_8[p_5_8_A],
            "ノイズの種類", TBL_5_9[p_5_9_A]
        )
    elseif effectA == 6 then
        obj.effect("モザイク",
            "サイズ", p_6_0_A,
            "タイル風", p_6_1_A
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        local args = {
            "X", p_1_0_B,
            "Y", p_1_1_B,
            "拡大率", p_1_2_B,
            "合成モード", TBL_1_3[p_1_3_B],
            "ループ画像", p_1_5_B,
        }
        if p_1_4_B ~= nil and p_1_4_B ~= "" then table.insert(args, "画像"); table.insert(args, p_1_4_B) end
        obj.effect("画像合成", unpack(args))
    elseif effectB == 2 then
        obj.effect("シャープ",
            "強さ", p_2_0_B,
            "範囲", p_2_1_B
        )
    elseif effectB == 3 then
        obj.effect("ノイズ除去",
            "強さ", p_3_0_B,
            "範囲", p_3_1_B,
            "しきい値", p_3_2_B
        )
    elseif effectB == 4 then
        obj.effect("インターレース解除",
            "解除方法", TBL_4_0[p_4_0_B]
        )
    elseif effectB == 5 then
        obj.effect("ノイズ",
            "強さ", p_5_0_B,
            "速度X", p_5_1_B,
            "速度Y", p_5_2_B,
            "変化速度", p_5_3_B,
            "周期X", p_5_4_B,
            "周期Y", p_5_5_B,
            "しきい値", p_5_6_B,
            "シード", p_5_7_B,
            "合成モード", TBL_5_8[p_5_8_B],
            "ノイズの種類", TBL_5_9[p_5_9_B]
        )
    elseif effectB == 6 then
        obj.effect("モザイク",
            "サイズ", p_6_0_B,
            "タイル風", p_6_1_B
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        local args = {
            "X", p_1_0_C,
            "Y", p_1_1_C,
            "拡大率", p_1_2_C,
            "合成モード", TBL_1_3[p_1_3_C],
            "ループ画像", p_1_5_C,
        }
        if p_1_4_C ~= nil and p_1_4_C ~= "" then table.insert(args, "画像"); table.insert(args, p_1_4_C) end
        obj.effect("画像合成", unpack(args))
    elseif effectC == 2 then
        obj.effect("シャープ",
            "強さ", p_2_0_C,
            "範囲", p_2_1_C
        )
    elseif effectC == 3 then
        obj.effect("ノイズ除去",
            "強さ", p_3_0_C,
            "範囲", p_3_1_C,
            "しきい値", p_3_2_C
        )
    elseif effectC == 4 then
        obj.effect("インターレース解除",
            "解除方法", TBL_4_0[p_4_0_C]
        )
    elseif effectC == 5 then
        obj.effect("ノイズ",
            "強さ", p_5_0_C,
            "速度X", p_5_1_C,
            "速度Y", p_5_2_C,
            "変化速度", p_5_3_C,
            "周期X", p_5_4_C,
            "周期Y", p_5_5_C,
            "しきい値", p_5_6_C,
            "シード", p_5_7_C,
            "合成モード", TBL_5_8[p_5_8_C],
            "ノイズの種類", TBL_5_9[p_5_9_C]
        )
    elseif effectC == 6 then
        obj.effect("モザイク",
            "サイズ", p_6_0_C,
            "タイル風", p_6_1_C
        )
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

@個別エフェクト(標準:オフスクリーン描画)
--label:個別エフェクト
--information:個別オブジェクトにした文字の中から、指定した範囲(A・B・Cグループ)をそれぞれ1つのオブジェクトとしてまとめ、各グループに個別のエフェクトを適用するスクリプト。グループ外の文字はそのまま表示される。使用できるエフェクトは標準スクリプトの「オフスクリーン描画」のみ。

--group:文字のまとめ方,true
--select@pack:方法=0,まとめない=0,範囲外の文字をまとめる=1,すべての文字をまとめる=2
--group

--group:Aグループ
--track@startA:Aグループ::開始A,1,100,1,1
--track@endA:Aグループ::終了A,1,100,1,1
--select@effectA:Aグループ::エフェクト=0,なし=0,オフスクリーン描画=1

--group

--group:Bグループ
--track@startB:Bグループ::開始B,1,100,1,1
--track@endB:Bグループ::終了B,1,100,1,1
--select@effectB:Bグループ::エフェクト=0,なし=0,オフスクリーン描画=1

--group

--group:Cグループ
--track@startC:Cグループ::開始C,1,100,1,1
--track@endC:Cグループ::終了C,1,100,1,1
--select@effectC:Cグループ::エフェクト=0,なし=0,オフスクリーン描画=1

--group


-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("オフスクリーン描画")
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        obj.effect("オフスクリーン描画")
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        obj.effect("オフスクリーン描画")
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

