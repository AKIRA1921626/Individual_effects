-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- グラデーション用のselectの数字を文字列に変換するテーブル
local GRD_TYPES = {"線形", "円形", "矩形", "凸形", "円錐形"}
local GRD_COMPOSITES = {"通常", "加算", "減算", "乗算", "スクリーン", "オーバーレイ", "比較(明)", "比較(暗)", "輝度", "色差", "陰影", "明暗", "差分"}
local CRD_INTERPOLATION = {"RGB", "OKLAB", "OKLCH", "OKLCH(+)", "OKLCH(-)"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("色調補正",
            "明るさ",tone_crr_luminanceA,
            "コントラスト",tone_crr_contrastA,
            "色相",tone_crr_hueA,
            "輝度",tone_crr_brightnessA,
            "彩度",tone_crr_saturationA,
            "飽和する",tone_crr_saturatedA
        )
    elseif effectA == 2 then
        obj.effect("グラデーション",
            "強さ",grd_powA,
            "中心X",grd_cxA,
            "中心Y",grd_cyA,
            "角度",grd_rotateA,
            "幅",grd_widthA,
            "合成モード",GRD_COMPOSITES[grd_compositeA],
            "形状",GRD_TYPES[grd_typeA],
            "色補間",CRD_INTERPOLATION[grd_interpolationA],
            "開始色",grd_start_colA,
            "終了色",grd_end_colA
        )
    elseif effectA == 3 then
        obj.effect("単色化",
            "強さ",monochro_powA,
            "色",monochro_colorA,
            "輝度を保持する",monochro_brightnessA
        )
    elseif effectA == 4 then
        if sc_conversion_afterA then -- 「変換後の色」が未設定(nil)なら、「変換後の色」がないほうを実行するように分岐させている。
            obj.effect("特定色域変換",
                "色相範囲",sc_conversion_hueA,
                "彩度範囲",sc_conversion_saturationA,
                "境界補正",sc_conversion_boudaryA,
                "変換前の色",sc_conversion_beforeA,
                "変換後の色",sc_conversion_afterA,
                "色彩補正",sc_conversion_correctionA
            )
        else
            obj.effect("特定色域変換",
                "色相範囲",sc_conversion_hueA,
                "彩度範囲",sc_conversion_saturationA,
                "境界補正",sc_conversion_boudaryA,
                "変換前の色",sc_conversion_beforeA,
                "色彩補正",sc_conversion_correctionA
            )
        end
    elseif effectA == 5 then
        obj.effect("拡張色設定",
            "R",extended_colorRA,
            "G",extended_colorGA,
            "B",extended_colorBA
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        obj.effect("色調補正",
            "明るさ",tone_crr_luminanceB,
            "コントラスト",tone_crr_contrastB,
            "色相",tone_crr_hueB,
            "輝度",tone_crr_brightnessB,
            "彩度",tone_crr_saturationB,
            "飽和する",tone_crr_saturatedB
        )
    elseif effectB == 2 then
        obj.effect("グラデーション",
            "強さ",grd_powB,
            "中心X",grd_cxB,
            "中心Y",grd_cyB,
            "角度",grd_rotateB,
            "幅",grd_widthB,
            "合成モード",GRD_COMPOSITES[grd_compositeB],
            "形状",GRD_TYPES[grd_typeB],
            "色補間",CRD_INTERPOLATION[grd_interpolationB],
            "開始色",grd_start_colB,
            "終了色",grd_end_colB
        )
    elseif effectB == 3 then
        obj.effect("単色化",
            "強さ",monochro_powB,
            "色",monochro_colorB,
            "輝度を保持する",monochro_brightnessB
        )
    elseif effectB == 4 then
        if sc_conversion_afterB then -- 「変換後の色」が未設定(nil)なら、「変換後の色」がないほうを実行するように分岐させている。
            obj.effect("特定色域変換",
                "色相範囲",sc_conversion_hueB,
                "彩度範囲",sc_conversion_saturationB,
                "境界補正",sc_conversion_boudaryB,
                "変換前の色",sc_conversion_beforeB,
                "変換後の色",sc_conversion_afterB,
                "色彩補正",sc_conversion_correctionB
            )
        else
            obj.effect("特定色域変換",
                "色相範囲",sc_conversion_hueB,
                "彩度範囲",sc_conversion_saturationB,
                "境界補正",sc_conversion_boudaryB,
                "変換前の色",sc_conversion_beforeB,
                "色彩補正",sc_conversion_correctionB
            )
        end
    elseif effectB == 5 then
        obj.effect("拡張色設定",
            "R",extended_colorRB,
            "G",extended_colorGB,
            "B",extended_colorBB
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        obj.effect("色調補正",
            "明るさ",tone_crr_luminanceC,
            "コントラスト",tone_crr_contrastC,
            "色相",tone_crr_hueC,
            "輝度",tone_crr_brightnessC,
            "彩度",tone_crr_saturationC,
            "飽和する",tone_crr_saturatedC
        )
    elseif effectC == 2 then
        obj.effect("グラデーション",
            "強さ",grd_powC,
            "中心X",grd_cxC,
            "中心Y",grd_cyC,
            "角度",grd_rotateC,
            "幅",grd_widthC,
            "合成モード",GRD_COMPOSITES[grd_compositeC],
            "形状",GRD_TYPES[grd_typeC],
            "色補間",CRD_INTERPOLATION[grd_interpolationC],
            "開始色",grd_start_colC,
            "終了色",grd_end_colC
        )
    elseif effectC == 3 then
        obj.effect("単色化",
            "強さ",monochro_powC,
            "色",monochro_colorC,
            "輝度を保持する",monochro_brightnessC
        )
    elseif effectC == 4 then
        if sc_conversion_afterC then -- 「変換後の色」が未設定(nil)なら、「変換後の色」がないほうを実行するように分岐させている。
            obj.effect("特定色域変換",
                "色相範囲",sc_conversion_hueC,
                "彩度範囲",sc_conversion_saturationC,
                "境界補正",sc_conversion_boudaryC,
                "変換前の色",sc_conversion_beforeC,
                "変換後の色",sc_conversion_afterC,
                "色彩補正",sc_conversion_correctionC
            )
        else
            obj.effect("特定色域変換",
                "色相範囲",sc_conversion_hueC,
                "彩度範囲",sc_conversion_saturationC,
                "境界補正",sc_conversion_boudaryC,
                "変換前の色",sc_conversion_beforeC,
                "色彩補正",sc_conversion_correctionC
            )
        end
    elseif effectC == 5 then
        obj.effect("拡張色設定",
            "R",extended_colorRC,
            "G",extended_colorGC,
            "B",extended_colorBC
        )
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

@個別エフェクト(標準:クリッピング)
--label:個別エフェクト
--information:個別オブジェクトにした文字の中から、指定した範囲(A・B・Cグループ)をそれぞれ1つのオブジェクトとしてまとめ、各グループに個別のエフェクトを適用するスクリプト。グループ外の文字はそのまま表示される。使用できるエフェクトは標準スクリプトの「クリッピング」のみ。

--group:文字のまとめ方,true
