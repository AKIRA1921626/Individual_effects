-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- selectの数字を文字列に変換するテーブル
local TBL_2_0 = {"標準", "カメラの方向を向く(横方向のみ)", "カメラの方向を向く(縦横方向のみ)", "カメラの方向を向く"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("材質設定(カメラ制御)",
            "光沢度", p_1_0_A
        )
    elseif effectA == 2 then
        obj.effect("カメラ制御オプション",
            "オブジェクトの向き", TBL_2_0[p_2_0_A],
            "裏面を表示しない", p_2_1_A
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        obj.effect("材質設定(カメラ制御)",
            "光沢度", p_1_0_B
        )
    elseif effectB == 2 then
        obj.effect("カメラ制御オプション",
            "オブジェクトの向き", TBL_2_0[p_2_0_B],
            "裏面を表示しない", p_2_1_B
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        obj.effect("材質設定(カメラ制御)",
            "光沢度", p_1_0_C
        )
    elseif effectC == 2 then
        obj.effect("カメラ制御オプション",
            "オブジェクトの向き", TBL_2_0[p_2_0_C],
            "裏面を表示しない", p_2_1_C
        )
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

