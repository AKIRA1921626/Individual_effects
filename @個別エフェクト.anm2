        )
    elseif effectC == 5 then
        obj.effect("円形配置",
            "円周", p_5_0_C,
            "半径", p_5_1_C,
            "回転", p_5_2_C,
            "ずらし", p_5_3_C,
            "数", p_5_4_C,
            "水平配置(カメラ制御)", p_5_5_C,
            "向き反転", p_5_6_C,
            "回転無し", p_5_7_C
        )
    elseif effectC == 6 then
        obj.effect("ランダム配置",
