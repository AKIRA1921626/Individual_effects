-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- selectの数字を文字列に変換するテーブル
local TBL_2_3 = {"ワイプ(円)", "ワイプ(四角)", "ワイプ(時計)", "ワイプ(横)", "ワイプ(縦)", "ワイプ(星型)", "ワイプ(ハート)"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("フェード",
            "イン", p_1_0_A,
            "アウト", p_1_1_A
        )
    elseif effectA == 2 then
        obj.effect("ワイプ",
            "イン", p_2_0_A,
            "アウト", p_2_1_A,
            "ぼかし", p_2_2_A,
            "ワイプの種類", TBL_2_3[p_2_3_A],
            "縦横比固定", p_2_4_A,
            "反転(イン)", p_2_5_A,
            "反転(アウト)", p_2_6_A
        )
    elseif effectA == 3 then
        obj.effect("画面外から登場",
            "時間", p_3_0_A,
            "角度", p_3_1_A,
            "数", p_3_2_A,
            "ランダム方向", p_3_3_A
        )
    elseif effectA == 4 then
        obj.effect("ランダム方向から登場",
            "時間", p_4_0_A,
            "回転", p_4_1_A,
            "ライト", p_4_2_A,
            "加減速", p_4_3_A
        )
    elseif effectA == 5 then
        obj.effect("拡大縮小して登場",
            "時間", p_5_0_A,
            "拡大率", p_5_1_A,
            "加減速", p_5_2_A
        )
    elseif effectA == 6 then
        obj.effect("ランダム間隔で落ちながら登場",
