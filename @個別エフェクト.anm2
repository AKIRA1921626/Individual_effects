-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- selectの数字を文字列に変換するテーブル
local TBL_2_2 = {"暗い部分を透過", "明るい部分を透過", "明暗部分を透過", "明暗部分を透過(補完なし)", "基準部分を透過", "基準部分を透過(補完なし)"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        local args = {
            "色相範囲", p_1_0_A,
            "彩度範囲", p_1_1_A,
            "境界補正", p_1_2_A,
            "色彩補正", p_1_4_A,
            "透過補正", p_1_5_A,
        }
        if p_1_3_A ~= nil then table.insert(args, "基準色"); table.insert(args, p_1_3_A) end
        obj.effect("クロマキー", unpack(args))
    elseif effectA == 2 then
        obj.effect("ルミナンスキー",
            "基準輝度", p_2_0_A,
            "輝度範囲", p_2_1_A,
            "モード", TBL_2_2[p_2_2_A]
        )
    elseif effectA == 3 then
        local args = {
            "輝度範囲", p_3_0_A,
            "色差範囲", p_3_1_A,
            "境界補正", p_3_2_A,
        }
        if p_3_3_A ~= nil then table.insert(args, "基準色"); table.insert(args, p_3_3_A) end
        obj.effect("カラーキー", unpack(args))
    elseif effectA == 4 then
        local args = {
            "強さ", p_4_0_A,
            "しきい値", p_4_1_A,
            "輝度エッジを抽出", p_4_3_A,
            "透明度エッジを抽出", p_4_4_A,
        }
        if p_4_2_A ~= nil then table.insert(args, "色"); table.insert(args, p_4_2_A) end
        obj.effect("エッジ抽出", unpack(args))
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        local args = {
            "色相範囲", p_1_0_B,
            "彩度範囲", p_1_1_B,
            "境界補正", p_1_2_B,
            "色彩補正", p_1_4_B,
            "透過補正", p_1_5_B,
        }
        if p_1_3_B ~= nil then table.insert(args, "基準色"); table.insert(args, p_1_3_B) end
        obj.effect("クロマキー", unpack(args))
    elseif effectB == 2 then
        obj.effect("ルミナンスキー",
            "基準輝度", p_2_0_B,
            "輝度範囲", p_2_1_B,
            "モード", TBL_2_2[p_2_2_B]
        )
    elseif effectB == 3 then
        local args = {
            "輝度範囲", p_3_0_B,
            "色差範囲", p_3_1_B,
            "境界補正", p_3_2_B,
        }
        if p_3_3_B ~= nil then table.insert(args, "基準色"); table.insert(args, p_3_3_B) end
        obj.effect("カラーキー", unpack(args))
    elseif effectB == 4 then
        local args = {
            "強さ", p_4_0_B,
            "しきい値", p_4_1_B,
            "輝度エッジを抽出", p_4_3_B,
            "透明度エッジを抽出", p_4_4_B,
        }
        if p_4_2_B ~= nil then table.insert(args, "色"); table.insert(args, p_4_2_B) end
        obj.effect("エッジ抽出", unpack(args))
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        local args = {
            "色相範囲", p_1_0_C,
            "彩度範囲", p_1_1_C,
            "境界補正", p_1_2_C,
            "色彩補正", p_1_4_C,
            "透過補正", p_1_5_C,
        }
        if p_1_3_C ~= nil then table.insert(args, "基準色"); table.insert(args, p_1_3_C) end
        obj.effect("クロマキー", unpack(args))
    elseif effectC == 2 then
        obj.effect("ルミナンスキー",
            "基準輝度", p_2_0_C,
            "輝度範囲", p_2_1_C,
            "モード", TBL_2_2[p_2_2_C]
        )
    elseif effectC == 3 then
        local args = {
            "輝度範囲", p_3_0_C,
            "色差範囲", p_3_1_C,
            "境界補正", p_3_2_C,
        }
        if p_3_3_C ~= nil then table.insert(args, "基準色"); table.insert(args, p_3_3_C) end
        obj.effect("カラーキー", unpack(args))
    elseif effectC == 4 then
        local args = {
            "強さ", p_4_0_C,
            "しきい値", p_4_1_C,
            "輝度エッジを抽出", p_4_3_C,
            "透明度エッジを抽出", p_4_4_C,
        }
        if p_4_2_C ~= nil then table.insert(args, "色"); table.insert(args, p_4_2_C) end
        obj.effect("エッジ抽出", unpack(args))
    end
end
-- ↑ Cグループエフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

@個別エフェクト(標準:変形)
