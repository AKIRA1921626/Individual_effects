-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- アンカーを表示するか非表示にするかをトラックバーで設定
if ankerA ~= 0 then
    obj.setanchor("entry_xA,entry_yA",0,"arm","color",0xff0000)
end
if ankerB ~= 0 then
    obj.setanchor("entry_xB,entry_yB",0,"arm","color",0x00ff00)
end
if ankerC ~= 0 then
    obj.setanchor("entry_xC,entry_yC",0,"arm","color",0x0000ff)
end

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("移動登場と退場_AKIRA",
            "登退場秒数",entry_timeA,
            "登場秒数",in_timeA,
            "退場秒数",out_timeA,
            "X",entry_xA,
            "Y",entry_yA,
            "Z",entry_zA,
            "拡大率",entry_zoomA,
            "X拡大率",entry_aspect_xA,
            "Y拡大率",entry_aspect_yA,
            "Z拡大率",entry_aspect_zA,
            "X回転",entry_rotate_xA,
            "Y回転",entry_rotate_yA,
            "Z回転",entry_rotate_zA,
            "登場順",0,
            "間隔",0,
            "イージングタイプ",entry_easingA,
            "登場",entry_inA,
            "退場",entry_outA,
            "INフェード",entry_in_fadeA,
            "インフェード時間",in_fade_timeA,
            "OUTフェード",entry_out_fadeA,
            "アウトフェード時間",out_fade_timeA
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        obj.effect("移動登場と退場_AKIRA",
            "登退場秒数",entry_timeB,
            "登場秒数",in_timeB,
            "退場秒数",out_timeB,
            "X",entry_xB,
            "Y",entry_yB,
            "Z",entry_zB,
            "拡大率",entry_zoomB,
            "X拡大率",entry_aspect_xB,
            "Y拡大率",entry_aspect_yB,
            "Z拡大率",entry_aspect_zB,
            "X回転",entry_rotate_xB,
            "Y回転",entry_rotate_yB,
            "Z回転",entry_rotate_zB,
            "登場順",0,
            "間隔",0,
            "イージングタイプ",entry_easingB,
            "登場",entry_inB,
            "退場",entry_outB,
            "INフェード",entry_in_fadeB,
            "インフェード時間",in_fade_timeB,
            "OUTフェード",entry_out_fadeB,
            "アウトフェード時間",out_fade_timeB
        )
    end
end
-- ↑ Bグループエフェクト追加ここまで ↑

-- Cグループ固有のエフェクト処理
local function apply_effect_C()
    if effectC == 1 then
        obj.effect("移動登場と退場_AKIRA",
            "登退場秒数",entry_timeC,
            "登場秒数",in_timeC,
            "退場秒数",out_timeC,
            "X",entry_xC,
            "Y",entry_yC,
            "Z",entry_zC,
            "拡大率",entry_zoomC,
            "X拡大率",entry_aspect_xC,
            "Y拡大率",entry_aspect_yC,
            "Z拡大率",entry_aspect_zC,
            "X回転",entry_rotate_xC,
            "Y回転",entry_rotate_yC,
            "Z回転",entry_rotate_zC,
            "登場順",0,
            "間隔",0,
            "イージングタイプ",entry_easingC,
            "登場",entry_inC,
            "退場",entry_outC,
            "INフェード",entry_in_fadeC,
            "インフェード時間",in_fade_timeC,
            "OUTフェード",entry_out_fadeC,
            "アウトフェード時間",out_fade_timeC
        )
    end
end
-- ↑ エフェクト追加ここまで ↑

-- 共通処理の実行
common.execute({
    startA  = startA,
    endA    = endA,
    effectA = apply_effect_A,

    startB  = startB,
    endB    = endB,
    effectB = apply_effect_B,

    startC  = startC,
    endC    = endC,
    effectC = apply_effect_C,

    pack    = pack
})

@個別エフェクト(手動設定)
--label:個別エフェクト
--information:個別オブジェクトにした文字の中から、指定した範囲(A・B・Cグループ)をそれぞれ1つのオブジェクトとしてまとめ、各グループに個別のエフェクトを適用するスクリプト。グループ外の文字はそのまま表示される。使用できるエフェクトは移動拡大透明度などの標準エフェクトのみ。

--group:文字のまとめ方,true
--select@pack:方法=0,まとめない=0,範囲外の文字をまとめる=1,すべての文字をまとめる=2
--group

--group:Aグループ
--track@startA:Aグループ::開始A,1,100,1,1
--track@endA:Aグループ::終了A,1,100,1,1
--select@effectA:Aグループ::各種設定=0,変更なし=0,手動設定=1

--check@ankerA:Aグループ::座標アンカー表示,0
--track@xA:Aグループ::X,-2000,2000,0
--track@yA:Aグループ::Y,-2000,2000,0
--track@zA:Aグループ::Z,-2000,2000,0
--trackgroup@xA,yA,zA:Agroup_pos
--track@zoomA:Aグループ::拡大率,0,1000,100
--track@aspect_xA:Aグループ::X拡大率,0,1000,50
--track@aspect_yA:Aグループ::Y拡大率,0,1000,50
--track@aspect_zA:Aグループ::Z拡大率,0,1000,50
--trackgroup@aspect_xA,aspect_yA,aspect_zA:Agroup_aspect
--track@alphaA:Aグループ::透明度,0,100,0,0.1
--track@rotate_xA:Aグループ::X回転,-3600,3600,0
--track@rotate_yA:Aグループ::Y回転,-3600,3600,0
--track@rotate_zA:Aグループ::Z回転,-3600,3600,0
--trackgroup@rotate_xA,rotate_yA,rotate_zA:Agroup_rotate
--select@rotationA:Aグループ::ローテーション=0,0°=0,90°=1,180°=2,270°=3,360°=4
--check@flip_verticallyA:Aグループ::上下反転,0
--check@horizontal_flipA:Aグループ::左右反転,0
--check@luminance_inversionA:Aグループ::輝度反転,0
--check@hue_inversionA:Aグループ::色相反転,0
--check@transparency_inversionA:Aグループ::透明度反転,0
--group

--group:Bグループ
--track@startB:Bグループ::開始B,1,100,1,1
--track@endB:Bグループ::終了B,1,100,1,1
--select@effectB:Bグループ::各種設定=0,変更なし=0,手動設定=1

--check@ankerB:Bグループ::座標アンカー表示,0
--track@xB:Bグループ::X,-2000,2000,0
--track@yB:Bグループ::Y,-2000,2000,0
--track@zB:Bグループ::Z,-2000,2000,0
--trackgroup@xB,yB,zB:Bgroup_pos
--track@zoomB:Bグループ::拡大率,0,1000,100
