--hide@blur_aspectC:effectC~=6
--hide@blur_lightC:effectC~=6

-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("縁取り",
        "サイズ",frame_sA,
        "ぼかし",frame_bA,
        "縁色",frame_colA
        )
    elseif effectA == 2 then
        obj.effect("枠線",
        "X",border_xA,
        "Y",border_yA,
        "サイズ",border_sA,
        "丸み",border_rA,
        "枠色",border_colA
        )
    elseif effectA == 3 then
        obj.effect("ドロップシャドウ",
        "X",drop_shadow_xA,
        "Y",drop_shadow_yA,
        "濃さ",drop_shadow_deepA,
        "拡散",drop_shadow_diffusionA,
        "影色",drop_shadow_colorA,
        "影を別オブジェクトで描画",0
        )
    elseif effectA == 4 then
        obj.effect("凸エッジ",
        "幅",edge_widthA,
        "高さ",edge_heightA,
        "角度",edge_rotateA
        )
    elseif effectA == 5 then -- 合成モード、形状への変換テーブル未作成のため、一旦定数。またアプデでグラデの使用は変わったようだが、未対応。
        obj.effect("グラデーション",
        "強さ",grd_powA,
        "中心X",grd_cxA,
        "中心Y",grd_cyA,
        "角度",grd_rotateA,
        "幅",grd_widthA,
        "合成モード","通常",
        "形状","線形",
        "開始色",grd_start_colA,
        "終了色",grd_end_colA
        )
    elseif effectA == 6 then
        obj.effect("ぼかし",
        "範囲",blur_rangeA,
        "縦横比",blur_aspectA,
        "光の強さ",blur_lightA,
        "サイズ固定",0
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        obj.effect("縁取り",
        "サイズ",frame_sB,
        "ぼかし",frame_bB,
        "縁色",frame_colB
        )
    elseif effectB == 2 then
        obj.effect("枠線",
        "X",border_xB,
        "Y",border_yB,
