-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        local args = {
            "サイズ", p_1_0_A,
            "ぼかし", p_1_1_A,
        }
        if p_1_2_A ~= nil then table.insert(args, "縁色"); table.insert(args, p_1_2_A) end
        if p_1_3_A ~= nil and p_1_3_A ~= "" then table.insert(args, "パターン画像"); table.insert(args, p_1_3_A) end
        obj.effect("縁取り", unpack(args))
    elseif effectA == 2 then
        local args = {
            "X", p_2_0_A,
            "Y", p_2_1_A,
            "サイズ", p_2_2_A,
            "丸み", p_2_3_A,
        }
        if p_2_4_A ~= nil then table.insert(args, "枠色"); table.insert(args, p_2_4_A) end
        if p_2_5_A ~= nil and p_2_5_A ~= "" then table.insert(args, "パターン画像"); table.insert(args, p_2_5_A) end
        obj.effect("枠線", unpack(args))
    elseif effectA == 3 then
        local args = {
            "X", p_3_0_A,
            "Y", p_3_1_A,
            "濃さ", p_3_2_A,
            "拡散", p_3_3_A,
            "影を別オブジェクトで描画", p_3_5_A,
        }
        if p_3_4_A ~= nil then table.insert(args, "影色"); table.insert(args, p_3_4_A) end
        obj.effect("ドロップシャドウ", unpack(args))
    elseif effectA == 4 then
        obj.effect("凸エッジ",
            "幅", p_4_0_A,
            "高さ", p_4_1_A,
            "角度", p_4_2_A
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
local function apply_effect_B()
    if effectB == 1 then
        local args = {
            "サイズ", p_1_0_B,
            "ぼかし", p_1_1_B,
        }
        if p_1_2_B ~= nil then table.insert(args, "縁色"); table.insert(args, p_1_2_B) end
        if p_1_3_B ~= nil and p_1_3_B ~= "" then table.insert(args, "パターン画像"); table.insert(args, p_1_3_B) end
