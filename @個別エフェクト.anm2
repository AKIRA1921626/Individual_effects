-- 個別エフェクトの共通処理のモジュール
local common = require("group_effect_common")

-- selectの数字を文字列に変換するテーブル
local TBL_2_2 = {"円", "四角形", "三角形", "五角形", "六角形", "星型", "ハート"}

-- Aグループ固有のエフェクト処理
local function apply_effect_A()
    if effectA == 1 then
        obj.effect("ぼかし",
            "範囲", p_1_0_A,
            "縦横比", p_1_1_A,
            "光の強さ", p_1_2_A,
            "サイズ固定", p_1_3_A
        )
    elseif effectA == 2 then
        obj.effect("レンズブラー",
            "範囲", p_2_0_A,
            "光の強さ", p_2_1_A,
            "形状", TBL_2_2[p_2_2_A],
            "サイズ固定", p_2_3_A
        )
    elseif effectA == 3 then
        obj.effect("放射ブラー",
            "範囲", p_3_0_A,
            "X", p_3_1_A,
            "Y", p_3_2_A,
            "サイズ固定", p_3_3_A
        )
    elseif effectA == 4 then
        obj.effect("方向ブラー",
            "範囲", p_4_0_A,
            "角度", p_4_1_A,
            "サイズ固定", p_4_2_A
        )
    elseif effectA == 5 then
        obj.effect("モーションブラー",
            "間隔", p_5_0_A,
            "分解能", p_5_1_A,
            "残像", p_5_2_A
        )
    elseif effectA == 6 then
        obj.effect("境界ぼかし",
            "範囲", p_6_0_A,
            "縦横比", p_6_1_A,
            "透明度の境界をぼかす", p_6_2_A
        )
    end
end
-- ↑ Aグループエフェクト追加ここまで ↑

-- Bグループ固有のエフェクト処理
